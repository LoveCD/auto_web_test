# ============================================================================
# qcoder-web-autotest-agent 环境变量模板
# 用法：复制本文件为 .env 并填写真实值（.env 已被 .gitignore 排除）
#   Windows:  copy .env.example .env
#   Linux:    cp .env.example .env
# 说明：真机地址/账号等敏感信息不写入代码与 profile.json，
#       全部通过环境变量或 .env 注入，保证工程可安全公开发布。
# ============================================================================

# ---- CM 真机（运营商：cm，环境：real）-------------------------------------
# 网关管理页基础地址（默认为 192.168.1.1，可不配）
QCT_CM_BASE_URL=http://192.168.1.1
# 管理员账号（必填，否则真机登录失败）
QCT_CM_ADMIN_USER=
QCT_CM_ADMIN_PASS=
# 普通用户账号（可选，用于角色登录用例）
QCT_CM_USER_USER=
QCT_CM_USER_PASS=

# ---- 自然语言用例生成（可选）----------------------------------------------
# 指向运营商 UI 源码 src 目录（fiberweb/html/src），用于 NL 生成器扫描页面索引。
# 不配置时使用 generator/index_cache 缓存；两者皆无则生成器报错并提示。
QCT_UI_SOURCE_CM_DIR=
QCT_UI_SOURCE_INTL_DIR=

# ---- e2e_bootstrap（Node Playwright 基线，见 e2e_bootstrap/.env.example）----
# 该子工程使用自己的 .env（e2e_bootstrap/.env），字段前缀 E2E_*
