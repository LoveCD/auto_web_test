# Required: target web base URL
E2E_BASE_URL=http://127.0.0.1:43173

# Required: demo path relative to E2E_BASE_URL
E2E_DEMO_PATH=/
# Optional: selector indicating page is ready
E2E_DEMO_READY_SELECTOR=

# Optional: reserved for login scenarios
E2E_USERNAME=
E2E_PASSWORD=

# Serial node/readback settings
E2E_SERIAL_PORT=COM52
E2E_SERIAL_BAUD=115200
E2E_SERIAL_WAKE_ENTERS=1
E2E_SERIAL_WAIT_MS=900
E2E_SERIAL_TAIL_WAIT_MS=1200
# auto | always | never
E2E_SERIAL_CREDENTIAL_MODE=auto
E2E_SERIAL_LEVEL1_USER=
E2E_SERIAL_LEVEL1_PASS=
E2E_SERIAL_LEVEL2_USER=
E2E_SERIAL_LEVEL2_PASS=
E2E_SERIAL_ENTER_CMD_1=ddd
E2E_SERIAL_ENTER_CMD_2=ts
E2E_SERIAL_NODE_READ_CMD=
E2E_SERIAL_NODE_READBACK_CMD=
E2E_SERIAL_LOG_PATH=./self-test-reports/serial-node-readback.log

# Optional execution tuning
E2E_SLOW_MO_MS=0
# Optional: screenshot mode for Playwright (on/off/only-on-failure)
E2E_SCREENSHOT_MODE=on
# Optional: auto start local static server before tests (true/false)
E2E_AUTO_START_SERVER=true
# Optional: web root for auto-start static server (defaults to e2e root)
E2E_WEB_ROOT=./

# Report settings
E2E_REPORT_TOPIC=Web UI Automation Self Test
E2E_REPORT_PROJECT_CODE=20260320
E2E_REPORT_PRECONDITIONS=Playwright dependencies installed and E2E_BASE_URL configured; test environment network reachable
E2E_REPORT_TEMPLATE_PATH=./templates/test-report-template.docx
