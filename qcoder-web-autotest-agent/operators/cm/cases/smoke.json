{
  "suite_id": "CM-REAL-SMOKE",
  "operator": "cm",
  "env": "real",
  "cases": [
    {
      "id": "TC-CM-LOGIN-001",
      "module": "Login",
      "priority": "P0",
      "title": "管理员账号登录成功",
      "steps": [
        {"action": "real.navigate", "params": {"path": "/login.html"}},
        {"action": "real.login", "params": {"role": "admin"},
          "expect": {"url_contains": "main.html", "visible": "main.app_container", "text_contains": "main.gateway_model_label"}},
        {"action": "real.screenshot", "params": {"name": "01_login_success_main"}}
      ]
    },
    {
      "id": "TC-CM-STATUS-001",
      "module": "Status",
      "priority": "P0",
      "title": "状态-设备信息页渲染",
      "steps": [
        {"action": "real.navigate_spa", "params": {"route": "/status/deviceInfo/deviceInfo"}},
        {"action": "real.screenshot", "params": {"name": "02_status_deviceInfo"}},
        {"action": "real.assert_page", "params": {"component": "deviceInfo"},
          "expect": {"visible": "page.container"}}
      ]
    },
    {
      "id": "TC-CM-STATUS-002",
      "module": "Status",
      "priority": "P0",
