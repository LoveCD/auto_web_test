[
  {
    "id": "INTL-AUTH-001",
    "title": "OLT 认证配置查询展示",
    "priority": "P1",
    "tags": ["suite:regression", "type:positive", "module:network", "专项:query"],
    "precondition": "设备已上电，已登录，浏览器可访问 192.168.1.1",
    "steps": [
      {"action": "real.navigate", "path": "/login.html", "desc": "访问登录页"},
      {"action": "real.login", "desc": "管理员登录"},
      {"action": "real.click_menu", "l1": "fhId_network_L1", "l2": "fhId_authentication_L2", "desc": "进入认证设置页"},
      {"action": "real.assert_url_contains", "substring": "authentication", "desc": "URL 应包含 authentication 路由"},
      {"action": "real.assert_visible", "selector": "auth.loid", "desc": "LOID 输入框可见"},
      {"action": "real.assert_visible", "selector": "auth.logic_password", "desc": "逻辑密码输入框可见"},
      {"action": "real.assert_visible", "selector": "auth.pass_key", "desc": "Pass Key 输入框可见"},
      {"action": "real.screenshot", "name": "INTL-AUTH-001_query", "desc": "截图 OLT 认证配置查询结果"}
    ]
  },
  {
    "id": "INTL-AUTH-002",
    "title": "LOID 合法修改并回读验证",
    "priority": "P1",
    "tags": ["suite:regression", "type:positive", "module:network", "专项:crud"],
    "precondition": "设备已上电，已登录，认证页可访问",
    "steps": [
      {"action": "real.navigate", "path": "/login.html", "desc": "访问登录页"},
      {"action": "real.login", "desc": "管理员登录"},
      {"action": "real.click_menu", "l1": "fhId_network_L1", "l2": "fhId_authentication_L2", "desc": "进入认证设置页"},
      {"action": "real.fill", "selector": "auth.loid", "value": "TestLOID001", "desc": "修改 LOID 为 TestLOID001"},
      {"action": "real.click", "selector": "auth.apply", "desc": "点击应用"},
      {"action": "real.wait", "ms": "2000", "desc": "等待应用生效"},
      {"action": "real.assert_input_value", "selector": "auth.loid", "value": "TestLOID001", "desc": "回读验证 LOID 已更新为 TestLOID001"},
      {"action": "real.screenshot", "name": "INTL-AUTH-002_applied", "desc": "截图修改结果"}
    ]
  },
  {
    "id": "INTL-AUTH-003",
    "title": "恢复 LOID 基线并应用逻辑密码修改",
    "priority": "P1",
    "tags": ["suite:regression", "type:positive", "module:network", "专项:crud"],
    "precondition": "设备已上电，已登录，认证页可访问",
    "steps": [
      {"action": "real.navigate", "path": "/login.html", "desc": "访问登录页"},
      {"action": "real.login", "desc": "管理员登录"},
      {"action": "real.click_menu", "l1": "fhId_network_L1", "l2": "fhId_authentication_L2", "desc": "进入认证设置页"},
      {"action": "real.fill", "selector": "auth.loid", "value": "", "desc": "恢复 LOID 为基线空值"},
      {"action": "real.click", "selector": "auth.apply", "desc": "点击应用 LOID"},
      {"action": "real.wait", "ms": "1500", "desc": "等待应用生效"},
      {"action": "real.fill", "selector": "auth.logic_password", "value": "TestPwd123", "desc": "修改逻辑密码为 TestPwd123"},
      {"action": "real.click", "selector": "auth.apply2", "desc": "点击应用逻辑密码"},
      {"action": "real.wait", "ms": "1500", "desc": "等待应用生效"},
      {"action": "real.assert_url_contains", "substring": "authentication", "desc": "应用后仍停留在认证页（无报错跳转）"},
      {"action": "real.screenshot", "name": "INTL-AUTH-003_pwd", "desc": "截图逻辑密码修改结果"}
    ]
  },
  {
    "id": "INTL-AUTH-004",
    "title": "恢复逻辑密码基线配置",
    "priority": "P1",
    "tags": ["suite:regression", "type:positive", "module:network", "专项:persist"],
    "precondition": "设备已上电，已登录，认证页可访问",
    "steps": [
      {"action": "real.navigate", "path": "/login.html", "desc": "访问登录页"},
      {"action": "real.login", "desc": "管理员登录"},
      {"action": "real.click_menu", "l1": "fhId_network_L1", "l2": "fhId_authentication_L2", "desc": "进入认证设置页"},
      {"action": "real.fill", "selector": "auth.logic_password", "value": "", "desc": "恢复逻辑密码为基线空值"},
      {"action": "real.click", "selector": "auth.apply2", "desc": "点击应用逻辑密码"},
      {"action": "real.wait", "ms": "1500", "desc": "等待应用生效"},
      {"action": "real.assert_input_value", "selector": "auth.logic_password", "value": "", "desc": "回读验证逻辑密码已恢复为空"},
      {"action": "real.screenshot", "name": "INTL-AUTH-004_restored", "desc": "截图恢复结果"}
    ]
  }
]
