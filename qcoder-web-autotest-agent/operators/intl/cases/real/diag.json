[
  {
    "id": "INTL-DIAG-001",
    "title": "网络诊断工具页面展示",
    "priority": "P1",
    "tags": ["suite:regression", "type:positive", "module:application", "专项:query"],
    "precondition": "设备已上电，已登录，浏览器可访问 192.168.1.1",
    "steps": [
      {"action": "real.navigate", "path": "/login.html", "desc": "访问登录页"},
      {"action": "real.login", "desc": "管理员登录"},
      {"action": "real.click_menu", "l1": "fhId_application_L1", "l2": "fhId_diagnose_L2", "desc": "进入诊断工具页"},
      {"action": "real.assert_url_contains", "substring": "diagnose", "desc": "URL 应包含 diagnose 路由"},
      {"action": "real.assert_visible", "selector": "diag.host", "desc": "目标地址输入框可见"},
      {"action": "real.assert_visible", "selector": "diag.repetitions", "desc": "重复次数输入框可见"},
      {"action": "real.assert_visible", "selector": "diag.diagnose_btn", "desc": "诊断按钮可见"},
      {"action": "real.screenshot", "name": "INTL-DIAG-001_query", "desc": "截图诊断工具页查询结果"}
    ]
  },
  {
    "id": "INTL-DIAG-002",
    "title": "Ping 诊断执行并输出结果",
    "priority": "P1",
    "tags": ["suite:regression", "type:positive", "module:application", "专项:query"],
    "precondition": "设备已上电，已登录，诊断页可访问",
    "steps": [
      {"action": "real.navigate", "path": "/login.html", "desc": "访问登录页"},
      {"action": "real.login", "desc": "管理员登录"},
      {"action": "real.click_menu", "l1": "fhId_application_L1", "l2": "fhId_diagnose_L2", "desc": "进入诊断工具页"},
      {"action": "real.fill", "selector": "diag.host", "value": "192.168.1.1", "desc": "输入 Ping 目标地址"},
      {"action": "real.fill", "selector": "diag.repetitions", "value": "3", "desc": "设置重复次数为 3"},
      {"action": "real.click", "selector": "diag.diagnose_btn", "desc": "点击诊断按钮"},
      {"action": "real.wait", "ms": "5000", "desc": "等待诊断执行"},
      {"action": "real.assert_url_contains", "substring": "diagnose", "desc": "诊断执行后仍停留在诊断页"},
      {"action": "real.screenshot", "name": "INTL-DIAG-002_ping", "desc": "截图 Ping 诊断结果"}
    ]
  }
]
