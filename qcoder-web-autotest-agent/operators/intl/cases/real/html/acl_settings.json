  {
    "id": "INTL-FW-029",
    "title": "ACL 总开关启用/禁用切换与回读",
    "priority": "P1",
    "tags": [
      "suite:regression",
      "type:positive",
      "module:firewall",
      "专项:persist"
    ],
    "precondition": "设备已上电，可正常登录",
    "steps": [
      {
        "action": "real.ensure_login",
        "desc": "确保已登录（会话复用：整个 run 只登录一次；会话失效自动重登）"
      },
      {
        "action": "real.click_menu",
        "l1": "fhId_security_L1",
        "l2": "fhId_firewall_L2",
        "l3": "fhId_aclSettings_L3",
        "desc": "导航到 ACL 设置"
      },
      {
        "action": "real.assert_url_contains",
        "substring": "aclSettings",
        "desc": "URL 含 aclSettings"
      },
      {
        "action": "real.click",
        "selector": "#fhId_firewall_disable",
        "desc": "切换：选择 Disable"
      },
      {
        "action": "real.click",
        "selector": "#fhId_onEnableApply",
        "desc": "切换：点击 Apply 保存"
      },
      {
        "action": "real.wait",
        "ms": "2500",
        "desc": "等待保存完成"
      },
      {
        "action": "real.assert_checkbox_checked",
        "selector": "#fhId_firewall_disable",
        "on": true,
        "desc": "回读：Disable 已选中"
      },
      {
        "action": "real.click",
        "selector": "#fhId_firewall_enable",
        "desc": "恢复：选择 Enable"
      },
      {
        "action": "real.click",
        "selector": "#fhId_onEnableApply",
        "desc": "恢复：点击 Apply 保存"
      },
      {
        "action": "real.wait",
        "ms": "2500",
        "desc": "等待保存完成"
      },
      {
        "action": "real.assert_checkbox_checked",
        "selector": "#fhId_firewall_enable",
        "on": true,
        "desc": "回读：Enable 已选中（恢复基线）"
      },
      {
        "action": "real.screenshot",
        "name": "INTL-FW-029_enable_toggle",
        "desc": "截图总开关切换完成状态"
      }
    ]
