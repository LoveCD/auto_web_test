  {
    "id": "INTL-FW-034",
    "title": "ACL 起始与结束 IP 同时为空可正常创建规则（合法行为）",
    "priority": "P1",
    "tags": [
      "suite:regression",
      "type:boundary",
      "module:firewall",
      "专项:crud"
    ],
    "precondition": "设备已上电；管理员可登录；ACL 列表出厂基线为 1 条源 IP 为空的通配规则",
    "steps": [
      {
        "action": "real.ensure_login",
        "desc": "确保已登录（会话复用：整个 run 只登录一次；会话失效自动重登）"
      },
      {
        "action": "real.click_menu",
        "l1": "fhId_security_L1",
        "l2": "fhId_firewall_L2",
        "l3": "fhId_aclSettings_L3",
        "desc": "导航到 ACL 设置"
      },
      {
        "action": "real.click",
        "selector": "#fhId_Add",
        "desc": "点击 Add 打开规则表单"
      },
      {
        "action": "real.fill",
        "selector": "#fhId_StartIp",
