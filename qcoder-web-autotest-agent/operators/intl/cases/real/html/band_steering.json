      {
        "action": "real.assert_text_contains",
        "selector": "body",
        "text": "Please enter an integer between -100 and 0",
        "desc": "越界 5G RSSI 阈值被校验拦截"
      },
      {
        "action": "real.screenshot",
        "name": "INTL-WIFI-020_rssi5g_high",
        "desc": "截图 5G RSSI 上限校验"
      }
    ]
  }
]
