[
  {
    "id": "INTL-APP-102",
    "title": "DDNS 页面可访问，添加规则后表单显示",
    "priority": "P1",
    "tags": [
      "suite:smoke",
      "type:positive",
      "module:application"
    ],
    "precondition": "设备已上电，可正常登录",
    "steps": [
      {
        "action": "real.ensure_login",
        "desc": "确保已登录（会话复用：整个 run 只登录一次；会话失效自动重登）"
      },
      {
        "action": "real.click_menu",
        "l1": "fhId_application_L1",
        "l2": "fhId_ddns_L2",
        "desc": "导航到 DDNS"
      },
      {
        "action": "real.assert_url_contains",
        "substring": "ddns",
        "desc": "URL 含 ddns"
      },
      {
        "action": "real.assert_visible",
        "selector": "#fhId_DDNSLists",
        "desc": "DDNS 规则列表表格可见"
      },
      {
        "action": "real.click",
        "selector": "#fhId_Add",
        "desc": "点击添加规则"
      },
      {
        "action": "real.assert_visible",
        "selector": "#fhId_DDNSCfgEnabled",
        "desc": "启用状态下拉可见"
      },
      {
        "action": "real.assert_visible",
        "selector": "#fhId_wanSelect",
        "desc": "WAN 接口下拉可见"
      },
      {
        "action": "real.assert_visible",
        "selector": "#fhId_DDNSUsername",
        "desc": "用户名输入框可见"
      },
      {
        "action": "real.assert_visible",
        "selector": "#fhId_DDNSPassword",
        "desc": "密码输入框可见"
      },
      {
        "action": "real.assert_visible",
        "selector": "#fhId_DDNSHostName",
        "desc": "主机名输入框可见"
      },
      {
        "action": "real.assert_visible",
        "selector": "#fhId_DDNSProvider",
        "desc": "服务商下拉可见"
      },
      {
        "action": "real.assert_visible",
        "selector": "#fhId_onApply",
        "desc": "应用按钮可见"
      },
      {
        "action": "real.screenshot",
        "name": "INTL-APP-102_ddns",
        "desc": "截图 DDNS 添加表单"
      }
    ]
  },
  {
    "id": "INTL-APP-103",
    "title": "DDNS 添加规则必填校验，未选 WAN 时提示",
    "priority": "P2",
    "tags": [
      "suite:regression",
      "type:negative",
      "module:application"
    ],
    "precondition": "设备已上电，可正常登录",
    "steps": [
      {
        "action": "real.ensure_login",
        "desc": "确保已登录（会话复用：整个 run 只登录一次；会话失效自动重登）"
      },
      {
        "action": "real.click_menu",
        "l1": "fhId_application_L1",
        "l2": "fhId_ddns_L2",
        "desc": "导航到 DDNS"
      },
      {
        "action": "real.click",
        "selector": "#fhId_Add",
        "desc": "点击添加规则"
      },
      {
        "action": "real.skip_if_filled",
        "selector": "#fhId_wanSelect",
        "steps": 3,
        "desc": "WAN 下拉已被预选（设备有 WAN 连接）则跳过后续 Apply/等待/断言"
      },
      {
        "action": "real.click",
        "selector": "#fhId_onApply",
        "desc": "不填任何字段直接点应用"
      },
      {
        "action": "real.wait",
        "desc": "等待校验提示",
        "ms": "1000"
      },
      {
        "action": "real.assert_text_contains",
        "selector": "body",
        "text": "Please select a WAN.",
        "desc": "提示先选择 WAN"
      },
      {
        "action": "real.screenshot",
        "name": "INTL-APP-103_ddns_wan_err",
        "desc": "截图 DDNS 必填校验"
      }
    ]
  },
  {
