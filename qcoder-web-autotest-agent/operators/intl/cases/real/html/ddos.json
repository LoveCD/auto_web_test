[
  {
    "id": "INTL-FW-010",
    "title": "DDoS 防护页面可访问",
    "priority": "P2",
    "tags": [
      "suite:regression",
      "type:positive",
      "module:firewall"
    ],
    "precondition": "设备已上电，可正常登录",
    "steps": [
      {
        "action": "real.ensure_login",
        "desc": "确保已登录（会话复用：整个 run 只登录一次；会话失效自动重登）"
      },
      {
        "action": "real.click_menu",
        "l1": "fhId_security_L1",
        "l2": "fhId_ddos_L2",
        "l3": "fhId_ddos_L3",
        "desc": "导航到 DDoS 防护"
      },
      {
        "action": "real.assert_url_contains",
        "substring": "ddos",
        "desc": "URL 含 ddos"
      },
      {
        "action": "real.assert_visible",
        "selector": "#fhId_onEnableApply",
        "desc": "应用按钮可见"
      },
      {
        "action": "real.screenshot",
        "name": "INTL-FW-010_ddos",
        "desc": "截图 DDoS 防护页"
      }
    ]
  }
]
