[
  {
    "id": "INTL-SYS-002",
    "title": "固件升级页面可访问，上传与移除控件可见",
    "priority": "P1",
    "tags": [
      "suite:smoke",
      "type:positive",
      "module:system"
    ],
    "precondition": "设备已上电，可正常登录",
    "steps": [
      {
        "action": "real.ensure_login",
        "desc": "确保已登录（会话复用：整个 run 只登录一次；会话失效自动重登）"
      },
      {
        "action": "real.click_menu",
        "l1": "fhId_management_L1",
        "l2": "fhId_deviceManagement_L2",
        "l3": "fhId_firmwareUp_L3",
        "desc": "导航到固件升级"
      },
      {
        "action": "real.assert_url_contains",
        "substring": "firmwareUp",
        "desc": "URL 含 firmwareUp"
      },
      {
        "action": "real.assert_visible",
        "selector": "#fhId_Update",
        "desc": "Update 上传按钮可见"
      },
      {
        "action": "real.assert_visible",
        "selector": "#fhId_removeFile",
        "desc": "移除文件按钮可见"
      },
      {
        "action": "real.screenshot",
        "name": "INTL-SYS-002_firmware",
        "desc": "截图固件升级页"
      }
    ]
  }
]
