      },
      {
        "action": "real.click",
        "selector": "#fhId_Add",
        "desc": "创建第二条：打开规则表单"
      },
      {
        "action": "real.select_option",
        "selector": "#fhId_Direction",
        "option_text": "Wan->Lan",
        "desc": "创建第二条：方向选 Wan->Lan"
      },
      {
        "action": "real.fill",
        "selector": "#fhId_SourceIPStart",
        "value": "3.3.3.2",
