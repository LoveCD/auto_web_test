      },
      {
        "action": "real.fill",
        "selector": "#fhId_DestPortStart",
        "value": "2000",
        "desc": "创建第二条：目的端口起始 2000"
      },
      {
        "action": "real.select_option",
        "selector": "#fhId_Protocol",
        "option_text": "TCP",
