[
  {
    "id": "INTL-NET-103",
    "title": "IPTV 设置页面可访问，代理开关与全局 VLAN 配置显示",
    "priority": "P1",
    "tags": [
      "suite:smoke",
      "type:positive",
      "module:network"
    ],
    "precondition": "设备已上电，可正常登录",
    "steps": [
      {
        "action": "real.ensure_login",
        "desc": "确保已登录（会话复用：整个 run 只登录一次；会话失效自动重登）"
      },
      {
        "action": "real.click_menu",
        "l1": "fhId_network_L1",
        "l2": "fhId_broadBandSettings_L2",
        "l3": "fhId_iptvSettings_L3",
        "desc": "导航到 IPTV 设置"
      },
      {
        "action": "real.assert_url_contains",
        "substring": "iptvSettings",
        "desc": "URL 含 iptvSettings"
      },
      {
        "action": "real.assert_visible",
        "selector": "#fhId_ProxyEnable",
        "desc": "IGMP 代理开关可见"
      },
      {
        "action": "real.assert_visible",
        "selector": "#fhId_MLDProxyEnable",
        "desc": "MLD 代理开关可见"
      },
      {
        "action": "real.assert_visible",
        "selector": "#fhId_GlobalVlan",
        "desc": "全局 VLAN 输入框可见"
      },
      {
        "action": "real.assert_visible",
        "selector": "#fhId_onEnableApply",
        "desc": "代理设置应用按钮可见"
      },
      {
        "action": "real.assert_visible",
        "selector": "#fhId_onApply",
        "desc": "VLAN 设置应用按钮可见"
      },
      {
        "action": "real.screenshot",
        "name": "INTL-NET-103_iptv",
        "desc": "截图 IPTV 设置页"
      }
    ]
  },
  {
    "id": "INTL-NET-104",
    "title": "IPTV 全局 VLAN 输入边界校验（1-4094）",
    "priority": "P2",
    "tags": [
      "suite:regression",
      "type:negative",
      "module:network"
    ],
    "precondition": "设备已上电，可正常登录",
    "steps": [
      {
        "action": "real.ensure_login",
        "desc": "确保已登录（会话复用：整个 run 只登录一次；会话失效自动重登）"
      },
      {
        "action": "real.click_menu",
        "l1": "fhId_network_L1",
        "l2": "fhId_broadBandSettings_L2",
        "l3": "fhId_iptvSettings_L3",
        "desc": "导航到 IPTV 设置"
      },
      {
        "action": "real.fill",
        "selector": "#fhId_GlobalVlan",
        "value": "0",
        "desc": "全局 VLAN 填 0，小于下限"
      },
      {
        "action": "real.wait",
        "desc": "等待校验提示",
        "ms": "1000"
      },
      {
        "action": "real.assert_text_contains",
        "selector": "body",
        "text": "Please enter an integer between 1 and 4094.",
        "desc": "提示 VLAN 范围错误"
      },
      {
        "action": "real.fill",
        "selector": "#fhId_GlobalVlan",
        "value": "4095",
        "desc": "全局 VLAN 填 4095，超过上限"
      },
      {
        "action": "real.wait",
        "desc": "等待校验提示",
        "ms": "1000"
      },
      {
        "action": "real.assert_text_contains",
        "selector": "body",
        "text": "Please enter an integer between 1 and 4094.",
        "desc": "再次提示 VLAN 范围错误"
      },
      {
        "action": "real.screenshot",
        "name": "INTL-NET-104_iptv_vlan_err",
        "desc": "截图 VLAN 校验错误"
      }
    ]
  }
]
