  {
    "id": "INTL-FW-037",
    "title": "IPv6 ACL 起始 IP 大于结束 IP 被校验拦截",
    "priority": "P1",
    "tags": [
      "suite:regression",
      "type:boundary",
      "module:firewall",
      "专项:crud"
    ],
    "precondition": "设备已上电，可正常登录",
    "steps": [
      {
        "action": "real.ensure_login",
        "desc": "确保已登录（会话复用：整个 run 只登录一次；会话失效自动重登）"
      },
      {
        "action": "real.click_menu",
        "l1": "fhId_security_L1",
        "l2": "fhId_firewall_L2",
        "l3": "fhId_ipv6AclSettings_L3",
        "desc": "导航到 IPv6 ACL 设置"
      },
      {
        "action": "real.click",
        "selector": "#fhId_Add",
        "desc": "点击 Add 打开规则表单"
      },
      {
        "action": "real.fill",
        "selector": "#fhId_StartIp",
        "value": "2001:db8::100",
        "desc": "起始 IPv6 填 2001:db8::100"
      },
      {
        "action": "real.fill",
        "selector": "#fhId_EndIp",
        "value": "2001:db8::1",
        "desc": "结束 IPv6 填 2001:db8::1（小于起始）"
      },
      {
        "action": "real.wait",
        "ms": "1000",
        "desc": "等待校验提示渲染"
      },
      {
        "action": "real.assert_text_contains",
        "selector": "body",
        "text": "End IP should be greater than or equal to the start IP.",
        "desc": "起始大于结束被校验拦截"
      },
      {
        "action": "real.click",
        "selector": "#fhId_onCancel",
        "desc": "点击 Cancel 关闭表单（不应用）"
      },
      {
        "action": "real.screenshot",
        "name": "INTL-FW-037_iprange",
        "desc": "截图 IPv6 范围校验"
      }
    ]
  }
]
