      },
      {
        "action": "real.fill",
        "selector": "#fhId_EndIp",
        "value": "2001:db8:1::4",
        "desc": "创建第二条：结束 IPv6 2001:db8:1::4"
      },
      {
        "action": "real.select_option",
        "selector": "#fhId_Direction",
        "option_text": "WAN",
        "desc": "创建第二条：方向选 WAN"
      },
      {
        "action": "real.select_option",
        "selector": "#fhId_Protocol",
        "option_text": "HTTP",
        "desc": "创建第二条：协议选 HTTP"
