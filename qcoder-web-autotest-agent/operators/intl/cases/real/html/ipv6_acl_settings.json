[
  {
    "id": "INTL-FW-009",
    "title": "IPv6 ACL 设置页面可访问，表单字段完整",
    "priority": "P2",
    "tags": [
      "suite:regression",
      "type:positive",
      "module:firewall",
      "专项:crud"
    ],
    "precondition": "设备已上电，可正常登录",
    "steps": [
      {
        "action": "real.ensure_login",
        "desc": "确保已登录（会话复用：整个 run 只登录一次；会话失效自动重登）"
      },
      {
        "action": "real.click_menu",
        "l1": "fhId_security_L1",
        "l2": "fhId_firewall_L2",
        "l3": "fhId_ipv6AclSettings_L3",
        "desc": "导航到 IPv6 ACL 设置"
      },
      {
        "action": "real.assert_url_contains",
        "substring": "ipv6AclSettings",
        "desc": "URL 含 ipv6AclSettings"
      },
      {
        "action": "real.assert_visible",
        "selector": "#fhId_firewall_enable",
        "desc": "启用 ACL 可见"
      },
      {
        "action": "real.assert_visible",
        "selector": "#fhId_firewall_disable",
        "desc": "禁用 ACL 可见"
      },
      {
        "action": "real.click",
        "selector": "#fhId_Add",
        "desc": "点击 Add 打开 ACL 表单"
      },
      {
        "action": "real.assert_visible",
        "selector": "#fhId_StartIp",
        "desc": "起始 IP 输入出现"
      },
      {
        "action": "real.assert_visible",
        "selector": "#fhId_EndIp",
        "desc": "结束 IP 输入出现"
      },
      {
        "action": "real.assert_option_present",
        "selector": "#fhId_Direction",
        "option_text": "WAN",
        "desc": "方向含 WAN"
      },
      {
        "action": "real.assert_option_present",
        "selector": "#fhId_Direction",
        "option_text": "LAN",
        "desc": "方向含 LAN"
      },
      {
        "action": "real.assert_option_present",
        "selector": "#fhId_Protocol",
        "option_text": "HTTP",
        "desc": "协议含 HTTP"
      },
      {
        "action": "real.assert_visible",
        "selector": "#fhId_ACLLists",
        "desc": "ACL 列表表格可见"
      },
      {
        "action": "real.screenshot",
        "name": "INTL-FW-009_ipv6acl",
        "desc": "截图 IPv6 ACL 设置页"
      }
    ]
  },
  {
    "id": "INTL-FW-035",
    "title": "IPv6 ACL 规则新增/修改/删除完整链路（CRUD）",
    "priority": "P1",
    "tags": [
      "suite:regression",
      "type:positive",
      "module:firewall",
      "专项:crud"
    ],
    "precondition": "设备已上电，可正常登录",
    "steps": [
      {
        "action": "real.ensure_login",
        "desc": "确保已登录（会话复用：整个 run 只登录一次；会话失效自动重登）"
      },
      {
        "action": "real.click_menu",
        "l1": "fhId_security_L1",
        "l2": "fhId_firewall_L2",
        "l3": "fhId_ipv6AclSettings_L3",
        "desc": "导航到 IPv6 ACL 设置"
      },
      {
        "action": "real.assert_url_contains",
        "substring": "ipv6AclSettings",
        "desc": "URL 含 ipv6AclSettings"
      },
      {
        "action": "real.click",
        "selector": "#fhId_Add",
        "desc": "新增：打开规则表单"
      },
      {
        "action": "real.select_option",
        "selector": "#fhId_RuleEnable",
        "option_text": "Yes",
        "desc": "新增：规则启用选 Yes"
      },
      {
        "action": "real.fill",
        "selector": "#fhId_StartIp",
        "value": "2001:db8::1",
        "desc": "新增：起始 IPv6 2001:db8::1"
      },
      {
        "action": "real.fill",
        "selector": "#fhId_EndIp",
        "value": "2001:db8::10",
        "desc": "新增：结束 IPv6 2001:db8::10"
      },
      {
        "action": "real.select_option",
        "selector": "#fhId_Direction",
        "option_text": "WAN",
        "desc": "新增：方向选 WAN"
      },
      {
        "action": "real.select_option",
        "selector": "#fhId_Protocol",
        "option_text": "HTTP",
        "desc": "新增：协议选 HTTP"
      },
      {
        "action": "real.click",
        "selector": "#fhId_onApply",
        "desc": "新增：点击 Apply 保存"
      },
      {
        "action": "real.wait",
        "ms": "2500",
        "desc": "等待保存完成"
      },
      {
        "action": "real.assert_text_contains",
        "selector": "body",
        "text": "2001:db8::1--2001:db8::10",
        "desc": "回读：列表出现新增规则 IP 范围"
      },
      {
        "action": "real.click",
        "selector": "text=2001:db8::1--2001:db8::10",
        "desc": "修改：点击规则行打开编辑"
      },
      {
        "action": "real.wait",
        "ms": "1500",
        "desc": "等待编辑表单加载"
      },
      {
        "action": "real.fill",
        "selector": "#fhId_EndIp",
        "value": "2001:db8::20",
        "desc": "修改：结束 IPv6 改为 2001:db8::20"
      },
      {
        "action": "real.click",
        "selector": "#fhId_onApply",
        "desc": "修改：点击 Apply 保存"
      },
      {
        "action": "real.wait",
        "ms": "2500",
        "desc": "等待修改保存"
      },
      {
        "action": "real.assert_text_contains",
        "selector": "body",
        "text": "2001:db8::1--2001:db8::20",
        "desc": "修改生效：列表回读新 IP 范围"
      },
      {
        "action": "real.click",
        "selector": "text=2001:db8::1--2001:db8::20",
        "desc": "非法修改：再次打开编辑"
      },
      {
        "action": "real.wait",
        "ms": "1500",
        "desc": "等待编辑表单加载"
      },
      {
        "action": "real.fill",
        "selector": "#fhId_StartIp",
        "value": "zzz",
        "desc": "非法修改：起始 IPv6 填非法值"
      },
      {
        "action": "real.click",
        "selector": "#fhId_onApply",
        "desc": "非法修改：点击 Apply"
      },
      {
        "action": "real.wait",
        "ms": "1000",
        "desc": "等待校验提示"
      },
      {
        "action": "real.assert_text_contains",
        "selector": "body",
        "text": "Please enter a valid IPv6 address!",
        "desc": "非法值被前端拦截"
      },
      {
        "action": "real.assert_text_contains",
        "selector": "body",
        "text": "2001:db8::1--2001:db8::20",
        "desc": "原值不变：列表仍显示原 IP 范围"
      },
      {
        "action": "real.click",
        "selector": "#fhId_onCancel",
        "desc": "关闭编辑表单（不应用非法修改）"
      },
      {
        "action": "real.delete_wan_row",
        "row_text": "2001:db8::1--2001:db8::20",
        "desc": "删除：勾选规则行并点击 Delete"
      },
      {
        "action": "real.assert_confirm_visible",
        "keyword": "Are you sure you want to delete the selected rule?",
        "desc": "删除：确认框出现"
      },
      {
        "action": "real.click_confirm",
        "accept": true,
        "desc": "删除：确认删除"
      },
      {
        "action": "real.wait",
        "ms": "2500",
        "desc": "等待删除完成"
      },
      {
        "action": "real.assert_text_not_contains",
        "selector": "body",
        "text": "2001:db8::1",
        "desc": "删除后无残留：规则已消失"
      },
      {
        "action": "real.screenshot",
        "name": "INTL-FW-035_crud_done",
        "desc": "截图 CRUD 链路完成状态"
      }
    ]
  },
  {
    "id": "INTL-FW-036",
    "title": "IPv6 ACL 规则批量删除（勾选多条后删除）",
    "priority": "P1",
    "tags": [
      "suite:regression",
      "type:positive",
      "module:firewall",
      "专项:crud"
    ],
    "precondition": "设备已上电，可正常登录",
    "steps": [
      {
        "action": "real.ensure_login",
        "desc": "确保已登录（会话复用：整个 run 只登录一次；会话失效自动重登）"
      },
      {
        "action": "real.click_menu",
        "l1": "fhId_security_L1",
        "l2": "fhId_firewall_L2",
        "l3": "fhId_ipv6AclSettings_L3",
        "desc": "导航到 IPv6 ACL 设置"
      },
      {
        "action": "real.click",
