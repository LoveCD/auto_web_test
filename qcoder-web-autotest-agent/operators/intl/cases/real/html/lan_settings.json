[
  {
    "id": "INTL-LAN-001",
    "title": "LAN 设置页面可访问，DHCP 服务选项完整",
    "priority": "P0",
    "tags": [
      "suite:smoke",
      "type:positive",
      "module:lan"
    ],
    "precondition": "设备已上电，可正常登录",
    "steps": [
      {
        "action": "real.ensure_login",
        "desc": "确保已登录（会话复用：整个 run 只登录一次；会话失效自动重登）"
      },
      {
        "action": "real.click_menu",
        "l1": "fhId_network_L1",
        "l2": "fhId_lanSettings_L2",
        "l3": "fhId_lanSettings_L3",
        "desc": "导航到 LAN 设置"
      },
      {
        "action": "real.assert_url_contains",
        "substring": "lanSettings",
        "desc": "URL 含 lanSettings"
      },
      {
        "action": "real.assert_visible",
        "selector": "#fhId_IPInterfaceIPAddress",
        "desc": "LAN IP 输入框可见"
      },
      {
        "action": "real.assert_visible",
        "selector": "#fhId_IPInterfaceSubnetMask",
        "desc": "子网掩码输入框可见"
      },
      {
        "action": "real.assert_visible",
        "selector": "#fhId_DHCPServerEnable",
        "desc": "DHCP 服务器下拉可见"
      },
      {
        "action": "real.assert_option_present",
        "selector": "#fhId_DHCPServerEnable",
        "option_text": "Server",
        "desc": "DHCP 服务含 Server"
      },
      {
        "action": "real.assert_option_present",
        "selector": "#fhId_DHCPServerEnable",
        "option_text": "Disable",
        "desc": "DHCP 服务含 Disable"
      },
      {
        "action": "real.assert_visible",
        "selector": "#fhId_IPV4MinAddress",
        "desc": "DHCP 起始地址可见"
      },
      {
        "action": "real.assert_visible",
        "selector": "#fhId_IPV4MaxAddress",
        "desc": "DHCP 结束地址可见"
      },
      {
        "action": "real.assert_visible",
        "selector": "#fhId_DHCPHours",
        "desc": "DHCP 租约小时输入可见"
      },
      {
        "action": "real.assert_visible",
        "selector": "#fhId_DHCPMinutes",
        "desc": "DHCP 租约分钟输入可见"
      },
      {
        "action": "real.assert_visible",
        "selector": "#fhId_onApply",
        "desc": "应用按钮可见"
      },
      {
        "action": "real.screenshot",
        "name": "INTL-LAN-001_settings",
        "desc": "截图 LAN 设置页"
      }
    ]
  },
  {
    "id": "INTL-LAN-002",
    "title": "LAN IP 输入非法 IPv4 被校验拦截",
    "priority": "P1",
    "tags": [
      "suite:regression",
      "type:boundary",
      "module:lan"
    ],
    "precondition": "设备已上电，可正常登录",
    "steps": [
      {
        "action": "real.ensure_login",
        "desc": "确保已登录（会话复用：整个 run 只登录一次；会话失效自动重登）"
      },
      {
        "action": "real.click_menu",
        "l1": "fhId_network_L1",
        "l2": "fhId_lanSettings_L2",
        "l3": "fhId_lanSettings_L3",
        "desc": "导航到 LAN 设置"
      },
      {
        "action": "real.fill",
        "selector": "#fhId_IPInterfaceIPAddress",
        "value": "192.168.1",
        "desc": "输入不完整 IPv4"
      },
      {
        "action": "real.wait",
        "ms": "1000",
        "desc": "等待校验提示渲染"
      },
      {
        "action": "real.click",
        "selector": "#fhId_onApply",
        "desc": "点击 Apply 触发校验"
      },
      {
        "action": "real.wait",
        "ms": "2000",
        "desc": "等待校验提示渲染"
      },
      {
        "action": "real.assert_text_contains",
        "selector": "body",
        "text": "Please enter a valid IPv4 address",
        "desc": "非法 LAN IP 被校验拦截"
      },
      {
        "action": "real.screenshot",
        "name": "INTL-LAN-002_ip_invalid",
        "desc": "截图 LAN IP 非法校验"
      }
    ]
  },
