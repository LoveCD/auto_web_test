[
  {
    "id": "INTL-STATUS-102",
    "title": "LAN 状态页面可访问，地址信息显示",
    "priority": "P1",
    "tags": [
      "suite:smoke",
      "type:positive",
      "module:status"
    ],
    "precondition": "设备已上电，可正常登录",
    "steps": [
      {
        "action": "real.ensure_login",
        "desc": "确保已登录（会话复用：整个 run 只登录一次；会话失效自动重登）"
      },
      {
        "action": "real.click_menu",
        "l1": "fhId_status_L1",
        "l2": "fhId_lanStatus_L2",
        "l3": "fhId_lanStatus_L3",
        "desc": "导航到 LAN 状态"
      },
      {
        "action": "real.assert_url_contains",
        "substring": "lanStatus",
        "desc": "URL 含 lanStatus"
      },
      {
        "action": "real.assert_visible",
        "selector": "#fhId_lanStatusInfo",
        "desc": "LAN 状态信息可见"
      },
      {
        "action": "real.screenshot",
        "name": "INTL-STATUS-102_lan",
        "desc": "截图 LAN 状态页"
      }
    ]
  }
]
