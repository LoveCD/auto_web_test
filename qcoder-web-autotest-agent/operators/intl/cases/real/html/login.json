[
  {
    "id": "INTL-LOGIN-001",
    "title": "正确账号密码登录成功，跳转首页",
    "priority": "P0",
    "tags": [
      "suite:smoke",
      "type:positive",
      "module:login"
    ],
    "precondition": "设备已上电，浏览器可访问 192.168.1.1",
    "steps": [
      {
        "action": "real.navigate",
        "path": "/login.html",
        "desc": "访问登录页"
      },
      {
        "action": "real.assert_visible",
        "selector": "#user_name",
        "desc": "用户名输入框可见"
      },
      {
        "action": "real.assert_visible",
        "selector": "#loginpp",
        "desc": "密码输入框可见"
      },
      {
        "action": "real.fill",
        "selector": "#user_name",
        "value": "${QCT_INTL_ADMIN_USER}",
        "desc": "输入正确用户名"
      },
      {
        "action": "real.fill",
        "selector": "#loginpp",
        "value": "${QCT_INTL_ADMIN_PASS}",
        "desc": "输入正确密码"
      },
      {
        "action": "real.click",
        "selector": "#login_btn",
        "desc": "点击登录"
      },
      {
        "action": "real.assert_url_contains",
        "substring": "main.html#/",
        "desc": "跳转主页面（SPA）"
      },
      {
        "action": "real.assert_visible",
        "selector": "#app",
        "desc": "主应用容器可见"
      },
      {
        "action": "real.screenshot",
        "name": "INTL-LOGIN-001_home",
        "desc": "截图首页"
      }
    ]
  },
  {
    "id": "INTL-LOGIN-002",
    "title": "错误密码/用户名前后空格登录失败，提示错误信息",
    "priority": "P0",
    "tags": [
      "suite:smoke",
      "suite:regression",
      "type:negative",
      "type:boundary",
      "module:login"
    ],
    "precondition": "设备已上电，浏览器可访问 192.168.1.1",
    "steps": [
      {
        "action": "real.navigate",
        "path": "/login.html",
        "desc": "访问登录页"
      },
      {
        "action": "real.fill",
        "selector": "#user_name",
        "value": "${QCT_INTL_ADMIN_USER}",
        "desc": "输入正确用户名"
      },
      {
        "action": "real.fill",
        "selector": "#loginpp",
        "value": "WrongPass123",
        "desc": "输入错误密码"
      },
      {
        "action": "real.click",
        "selector": "#login_btn",
        "desc": "点击登录"
      },
      {
        "action": "real.assert_login_error",
        "desc": "断言错误提示显示"
      },
      {
        "action": "real.assert_url_contains",
        "substring": "login.html",
        "desc": "仍停留在登录页"
      },
      {
        "action": "real.screenshot",
        "name": "INTL-LOGIN-002_error",
        "desc": "截图错误提示"
      },
      {
        "action": "real.fill",
        "selector": "#user_name",
        "value": " ${QCT_INTL_ADMIN_USER} ",
        "desc": "输入带前后空格的用户名"
      },
      {
        "action": "real.fill",
        "selector": "#loginpp",
        "value": "${QCT_INTL_ADMIN_PASS}",
        "desc": "输入正确密码"
      },
      {
        "action": "real.click",
        "selector": "#login_btn",
        "desc": "点击登录（用户名带空格）"
      },
      {
        "action": "real.assert_login_error",
        "desc": "断言错误提示显示（空格不自动去除）"
      },
      {
        "action": "real.assert_url_contains",
        "substring": "login.html",
        "desc": "仍停留在登录页"
      }
    ]
  },
  {
    "id": "INTL-LOGIN-003",
    "title": "空用户名/空密码登录被前端校验拦截",
    "priority": "P1",
    "tags": [
      "suite:regression",
      "type:negative",
      "module:login"
    ],
    "precondition": "设备已上电，浏览器可访问 192.168.1.1",
    "steps": [
      {
        "action": "real.navigate",
        "path": "/login.html",
        "desc": "访问登录页"
      },
      {
        "action": "real.fill",
        "selector": "#user_name",
        "value": "",
        "desc": "清空用户名"
      },
      {
        "action": "real.fill",
        "selector": "#loginpp",
        "value": "${QCT_INTL_ADMIN_PASS}",
        "desc": "输入正确密码"
      },
      {
        "action": "real.click",
        "selector": "#login_btn",
        "desc": "点击登录（空用户名）"
      },
      {
        "action": "real.assert_login_stays",
        "desc": "前端校验拦截（空用户名），停留登录页且无错误提示"
      },
      {
        "action": "real.fill",
        "selector": "#user_name",
        "value": "${QCT_INTL_ADMIN_USER}",
        "desc": "输入正确用户名"
      },
      {
        "action": "real.fill",
        "selector": "#loginpp",
        "value": "",
        "desc": "清空密码"
      },
      {
        "action": "real.click",
        "selector": "#login_btn",
        "desc": "点击登录（空密码）"
      },
      {
        "action": "real.assert_login_stays",
        "desc": "前端校验拦截（空密码），停留登录页且无错误提示"
      }
    ]
  },
  {
    "id": "INTL-LOGIN-004",
    "title": "登出后返回登录页",
    "priority": "P0",
    "tags": [
      "suite:smoke",
      "type:positive",
      "module:login"
    ],
    "precondition": "设备已上电，可正常登录",
    "steps": [
      {
        "action": "real.navigate",
        "path": "/login.html",
        "desc": "访问登录页"
      },
      {
        "action": "real.fill",
        "selector": "#user_name",
        "value": "${QCT_INTL_ADMIN_USER}",
        "desc": "输入正确用户名"
      },
      {
        "action": "real.fill",
        "selector": "#loginpp",
        "value": "${QCT_INTL_ADMIN_PASS}",
        "desc": "输入正确密码"
      },
      {
        "action": "real.click",
        "selector": "#login_btn",
        "desc": "点击登录"
      },
      {
        "action": "real.assert_url_contains",
        "substring": "main.html#/",
        "desc": "登录成功"
      },
      {
        "action": "real.logout",
        "desc": "点击登出并确认"
      },
      {
        "action": "real.assert_url_contains",
        "substring": "login.html",
        "desc": "登出后回到登录页"
      },
      {
        "action": "real.screenshot",
        "name": "INTL-LOGIN-004_logout",
        "desc": "截图登出后页面"
      }
    ]
  },
  {
    "id": "INTL-LOGIN-005",
    "title": "未登录直接访问受保护页面，跳转登录页",
    "priority": "P1",
    "tags": [
      "suite:regression",
      "type:negative",
      "module:login",
      "专项:auth"
    ],
    "precondition": "设备已上电；前置步骤先登录再显式退出，确保设备端（按 IP 维持的）会话已失效、处于退出状态",
    "steps": [
      {
        "action": "real.navigate",
        "path": "/login.html",
        "desc": "访问登录页"
      },
      {
        "action": "real.login",
        "desc": "前置：先登录一次，激活设备端会话"
      },
      {
        "action": "real.assert_url_contains",
        "substring": "main.html",
        "desc": "前置：登录成功"
      },
      {
        "action": "real.logout",
        "desc": "前置：显式退出，注销设备端会话，确保退出状态"
      },
      {
        "action": "real.navigate",
        "path": "/main.html#/status/deviceInfo/deviceInfo",
        "desc": "未登录直接访问受保护页面"
      },
      {
        "action": "real.assert_unauth_redirect",
        "desc": "未登录访问应跳转登录页或登录表单可见"
      }
    ]
  }
]