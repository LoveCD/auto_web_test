  {
    "id": "INTL-MOBILE-005",
    "title": "手机端重启页兼容性：确认框弹出与取消",
    "priority": "P1",
    "tags": [
      "suite:regression",
      "type:positive",
      "module:mobile",
      "device:mobile"
    ],
    "precondition": "设备已上电，可正常登录（手机端形态：iPhone 13 视口/UA/触摸模拟）",
    "steps": [
      {
        "action": "real.navigate",
        "path": "/login.html",
        "desc": "手机端访问登录页"
      },
      {
        "action": "real.fill",
        "selector": "#user_name",
        "value": "${QCT_INTL_ADMIN_USER}",
        "desc": "输入用户名"
      },
      {
        "action": "real.fill",
        "selector": "#loginpp",
        "value": "${QCT_INTL_ADMIN_PASS}",
        "desc": "输入密码"
      },
      {
        "action": "real.click",
        "selector": "#login_btn",
        "desc": "登录"
      },
      {
        "action": "real.click_menu",
        "l1": "fhId_management_L1",
        "l2": "fhId_deviceManagement_L2",
        "l3": "fhId_rebootDevice_L3",
        "desc": "手机端导航到重启页面"
      },
      {
        "action": "real.assert_url_contains",
        "substring": "rebootDevice",
        "desc": "手机端导航成功（URL 含 rebootDevice）"
      },
      {
        "action": "real.assert_visible",
        "selector": "#fhId_Reboot",
        "desc": "Reboot 按钮在手机端可见"
      },
      {
        "action": "real.click",
        "selector": "#fhId_Reboot",
        "desc": "手机端点击 Reboot 按钮"
      },
      {
        "action": "real.assert_confirm_visible",
        "keyword": "reboot",
        "desc": "手机端确认对话框出现且含 reboot 提示"
      },
      {
        "action": "real.screenshot",
        "name": "INTL-MOBILE-005_confirm",
        "desc": "截图手机端重启确认框"
      },
      {
        "action": "real.click_confirm",
        "accept": false,
        "desc": "手机端点击 Cancel 取消"
      },
      {
        "action": "real.assert_confirm_hidden",
        "desc": "手机端确认框正常关闭"
      },
      {
        "action": "real.assert_url_contains",
        "substring": "rebootDevice",
        "desc": "仍停留在重启页（未重启）"
      }
    ]
  }
]