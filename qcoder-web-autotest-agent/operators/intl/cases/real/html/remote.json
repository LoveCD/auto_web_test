[
  {
    "id": "INTL-REMOTE-001",
    "title": "TR-069 ACS 服务器页面可访问，配置项完整",
    "priority": "P1",
    "tags": [
      "suite:smoke",
      "type:positive",
      "module:remote"
    ],
    "precondition": "设备已上电，可正常登录",
    "steps": [
      {
        "action": "real.ensure_login",
        "desc": "确保已登录（会话复用：整个 run 只登录一次；会话失效自动重登）"
      },
      {
        "action": "real.click_menu",
        "l1": "fhId_network_L1",
        "l2": "fhId_remoteManagement_L2",
        "l3": "fhId_acsServer_L3",
        "desc": "导航到 ACS 服务器"
      },
      {
        "action": "real.assert_url_contains",
        "substring": "acsServer",
        "desc": "URL 含 acsServer"
      },
      {
        "action": "real.assert_visible",
        "selector": "#fhId_TR69Enable",
        "desc": "启用 TR-069 单选项可见"
      },
      {
        "action": "real.assert_visible",
        "selector": "#fhId_TR69Disable",
        "desc": "禁用 TR-069 单选项可见"
      },
      {
        "action": "real.assert_visible",
        "selector": "#fhId_TR69URL",
        "desc": "ACS URL 输入可见"
      },
      {
        "action": "real.assert_visible",
        "selector": "#fhId_TR69Username",
        "desc": "ACS 用户名输入可见"
      },
      {
        "action": "real.assert_visible",
        "selector": "#fhId_TR69Pwd",
        "desc": "ACS 密码输入可见"
      },
      {
        "action": "real.assert_visible",
        "selector": "#fhId_TR69ConPath",
        "desc": "连接请求路径输入可见"
      },
      {
        "action": "real.assert_visible",
        "selector": "#fhId_TR69ConPort",
        "desc": "连接请求端口输入可见"
      },
      {
        "action": "real.assert_visible",
        "selector": "#fhId_TR69ReqUsr",
        "desc": "连接请求用户名输入可见"
      },
      {
        "action": "real.assert_visible",
        "selector": "#fhId_TR69ReqPwd",
        "desc": "连接请求密码输入可见"
      },
      {
        "action": "real.assert_visible",
        "selector": "#fhId_TR69InformEnable",
        "desc": "Inform 上报单选项可见"
      },
      {
        "action": "real.assert_visible",
        "selector": "#fhId_TR69InformInterval",
        "desc": "上报间隔输入可见"
      },
      {
        "action": "real.assert_visible",
        "selector": "#fhId_onEnableApply",
        "desc": "应用按钮可见"
      },
      {
        "action": "real.screenshot",
        "name": "INTL-REMOTE-001_acs",
        "desc": "截图 ACS 服务器页"
      }
    ]
  },
  {
    "id": "INTL-REMOTE-002",
    "title": "ACS URL 格式非法被校验拦截",
    "priority": "P1",
    "tags": [
      "suite:regression",
      "type:boundary",
      "module:remote"
    ],
    "precondition": "设备已上电，可正常登录",
    "steps": [
      {
        "action": "real.ensure_login",
        "desc": "确保已登录（会话复用：整个 run 只登录一次；会话失效自动重登）"
      },
      {
        "action": "real.click_menu",
        "l1": "fhId_network_L1",
        "l2": "fhId_remoteManagement_L2",
        "l3": "fhId_acsServer_L3",
        "desc": "导航到 ACS 服务器"
      },
      {
        "action": "real.fill",
        "selector": "#fhId_TR69URL",
        "value": "001",
        "desc": "输入格式非法的 ACS URL"
      },
      {
        "action": "real.wait",
        "ms": "1000",
        "desc": "等待校验提示渲染"
      },
      {
        "action": "real.click",
        "selector": "#fhId_onApply",
        "desc": "点击 Apply 触发校验"
      },
      {
        "action": "real.wait",
        "ms": "2000",
        "desc": "等待校验提示渲染"
      },
      {
        "action": "real.assert_text_contains",
        "selector": "body",
        "text": "Please enter a valid URL",
        "desc": "非法 URL 被校验拦截"
      },
      {
        "action": "real.screenshot",
        "name": "INTL-REMOTE-002_url",
        "desc": "截图 ACS URL 校验"
      }
    ]
  },
