  {
    "id": "INTL-LAN-013",
    "title": "静态 IP 绑定 IP 不在 DHCP 地址池内被校验拦截",
    "priority": "P1",
    "tags": [
      "suite:regression",
      "type:boundary",
      "module:lan",
      "专项:crud"
    ],
    "precondition": "设备已上电，可正常登录；DHCP 地址池非公网网段",
    "steps": [
      {
        "action": "real.ensure_login",
        "desc": "确保已登录（会话复用：整个 run 只登录一次；会话失效自动重登）"
      },
      {
        "action": "real.click_menu",
        "l1": "fhId_network_L1",
        "l2": "fhId_lanSettings_L2",
        "l3": "fhId_staticIPSettings_L3",
        "desc": "导航到静态 IP 绑定"
      },
      {
        "action": "real.click",
        "selector": "#fhId_Add",
        "desc": "点击 Add 打开绑定表单"
      },
      {
        "action": "real.fill",
        "selector": "#fhId_IPAddress",
        "value": "8.8.8.8",
        "desc": "输入不在地址池内的 IP"
      },
      {
        "action": "real.wait",
        "ms": "1000",
        "desc": "等待校验提示渲染"
      },
      {
        "action": "real.assert_text_contains",
        "selector": "body",
        "text": "This IP is not in IP pool",
        "desc": "池外 IP 被校验拦截"
      },
      {
        "action": "real.click",
        "selector": "#fhId_onCancel",
        "desc": "点击 Cancel 关闭表单（不应用）"
      },
      {
        "action": "real.screenshot",
        "name": "INTL-LAN-013_ip_pool",
        "desc": "截图 IP 地址池校验"
      }
    ]
  },
