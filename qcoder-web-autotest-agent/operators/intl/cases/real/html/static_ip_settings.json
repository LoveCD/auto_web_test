[
  {
    "id": "INTL-LAN-005",
    "title": "静态 IP 绑定页面可访问，Add 表单与操作按钮完整",
    "priority": "P1",
    "tags": [
      "suite:regression",
      "type:positive",
      "module:lan",
      "专项:crud"
    ],
    "precondition": "设备已上电，可正常登录",
    "steps": [
      {
        "action": "real.ensure_login",
        "desc": "确保已登录（会话复用：整个 run 只登录一次；会话失效自动重登）"
      },
      {
        "action": "real.click_menu",
        "l1": "fhId_network_L1",
        "l2": "fhId_lanSettings_L2",
        "l3": "fhId_staticIPSettings_L3",
        "desc": "导航到静态 IP 绑定"
      },
      {
        "action": "real.assert_url_contains",
        "substring": "staticIPSettings",
        "desc": "URL 含 staticIPSettings"
      },
      {
        "action": "real.assert_visible",
        "selector": "#fhId_Add",
        "desc": "Add 按钮可见"
      },
      {
        "action": "real.assert_visible",
        "selector": "#fhId_Delete",
        "desc": "Delete 按钮可见"
      },
      {
        "action": "real.assert_visible",
        "selector": "#fhId_staticIPList",
        "desc": "绑定列表表格可见"
      },
      {
        "action": "real.click",
        "selector": "#fhId_Add",
        "desc": "点击 Add 打开绑定表单"
      },
      {
        "action": "real.assert_visible",
        "selector": "#fhId_IPAddress",
        "desc": "IP 地址输入框出现"
      },
      {
        "action": "real.assert_visible",
        "selector": "#fhId_MACAddress",
        "desc": "MAC 地址输入框出现"
      },
      {
        "action": "real.click",
        "selector": "#fhId_onCancel",
        "desc": "点击 Cancel 关闭表单（不应用）"
      },
      {
        "action": "real.screenshot",
        "name": "INTL-LAN-005_staticip",
        "desc": "截图静态 IP 绑定页"
      }
    ]
  },
