[
  {
    "id": "INTL-ROUTE-002",
    "title": "静态路由页面可访问，新增路由表单完整（CRUD-Create）",
    "priority": "P1",
    "tags": [
      "suite:regression",
      "type:positive",
      "module:route",
      "专项:crud"
    ],
    "precondition": "设备已上电，可正常登录",
    "steps": [
      {
        "action": "real.ensure_login",
        "desc": "确保已登录（会话复用：整个 run 只登录一次；会话失效自动重登）"
      },
      {
        "action": "real.click_menu",
        "l1": "fhId_network_L1",
        "l2": "fhId_routeSettings_L2",
        "l3": "fhId_staticRoute_L3",
        "desc": "导航到静态路由"
      },
      {
        "action": "real.assert_url_contains",
        "substring": "staticRoute",
        "desc": "URL 含 staticRoute"
      },
      {
        "action": "real.assert_visible",
        "selector": "#fhId_Add",
        "desc": "Add 按钮可见"
      },
      {
        "action": "real.assert_visible",
        "selector": "#fhId_Delete",
        "desc": "Delete 按钮可见"
      },
      {
        "action": "real.assert_visible",
        "selector": "#fhId_staticRouteList",
        "desc": "静态路由列表表格可见"
      },
      {
        "action": "real.click",
        "selector": "#fhId_Add",
        "desc": "点击 Add 打开路由表单"
      },
      {
        "action": "real.assert_visible",
        "selector": "#fhId_selectWan",
        "desc": "WAN 选择出现"
      },
      {
        "action": "real.assert_visible",
        "selector": "#fhId_GatewayIPAddress",
        "desc": "网关地址输入出现"
      },
      {
        "action": "real.assert_visible",
        "selector": "#fhId_DestIPAddress",
        "desc": "目的 IP 输入出现"
      },
      {
        "action": "real.assert_visible",
        "selector": "#fhId_DestSubnetMask",
        "desc": "目的子网掩码输入出现"
      },
      {
        "action": "real.screenshot",
        "name": "INTL-ROUTE-002_static",
        "desc": "截图静态路由页"
      }
    ]
  },
