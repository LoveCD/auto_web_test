[
  {
    "id": "INTL-STATUS-001",
    "title": "系统状态页面可访问，设备信息正常显示",
    "priority": "P0",
    "tags": [
      "suite:smoke",
      "type:positive",
      "module:status"
    ],
    "precondition": "设备已上电，可正常登录",
    "steps": [
      {
        "action": "real.ensure_login",
        "desc": "确保已登录（会话复用：整个 run 只登录一次；会话失效自动重登）"
      },
      {
        "action": "real.click_menu",
        "l1": "fhId_status_L1",
        "l2": "fhId_deviceInfo_L2",
        "desc": "导航到设备信息"
      },
      {
        "action": "real.assert_url_contains",
        "substring": "deviceInfo",
        "desc": "URL 含 deviceInfo"
      },
      {
        "action": "real.assert_visible",
        "selector": "#fhId_SoftwareVersion",
        "desc": "软件版本字段可见"
      },
      {
        "action": "real.assert_visible",
        "selector": "#fhId_ModelName",
        "desc": "设备型号字段可见"
      },
      {
        "action": "real.screenshot",
        "name": "INTL-STATUS-001_deviceinfo",
        "desc": "截图设备信息页"
      }
    ]
  },
  {
    "id": "INTL-STATUS-002",
    "title": "关键设备信息字段均有有效值",
    "priority": "P0",
    "tags": [
      "suite:smoke",
      "type:positive",
      "module:status"
    ],
    "precondition": "设备已上电，可正常登录",
    "steps": [
      {
        "action": "real.ensure_login",
        "desc": "确保已登录（会话复用：整个 run 只登录一次；会话失效自动重登）"
      },
      {
        "action": "real.click_menu",
        "l1": "fhId_status_L1",
        "l2": "fhId_deviceInfo_L2",
        "desc": "导航到设备信息"
      },
      {
        "action": "real.assert_text_not_contains",
        "selector": "#fhId_SoftwareVersion",
        "text": "N/A",
        "desc": "软件版本非 N/A"
      },
      {
        "action": "real.assert_text_not_contains",
        "selector": "#fhId_ModelName",
        "text": "N/A",
        "desc": "设备型号非 N/A"
      },
      {
        "action": "real.assert_text_not_contains",
        "selector": "#fhId_SerialNumber",
        "text": "N/A",
        "desc": "序列号非 N/A"
      },
      {
        "action": "real.assert_text_not_contains",
        "selector": "#fhId_MAC_Address",
        "text": "N/A",
        "desc": "MAC 地址非 N/A"
      },
      {
        "action": "real.assert_text_not_contains",
        "selector": "#fhId_SystemUpTime",
        "text": "N/A",
        "desc": "运行时间非 N/A"
      },
      {
        "action": "real.assert_field_nonempty",
        "selector": "#fhId_SoftwareVersion",
        "desc": "软件版本非空"
      },
      {
        "action": "real.assert_field_nonempty",
        "selector": "#fhId_HardwareVersion",
        "desc": "硬件版本非空"
      },
      {
        "action": "real.assert_field_nonempty",
        "selector": "#fhId_ModelName",
        "desc": "设备型号非空"
      },
      {
        "action": "real.assert_field_in",
        "selector": "#fhId_ModelPonType",
        "values": [
          "EPON",
          "GPON",
          "EPON_10G",
          "EPON_10G_S",
          "XGPON",
          "XGSPON"
        ],
        "desc": "PON 类型为源码枚举值"
      },
      {
        "action": "real.assert_field_nonempty",
        "selector": "#fhId_SerialNumber",
        "optional": true,
        "desc": "序列号非空（PON 设备显示，字段缺失视为通过）"
      },
      {
        "action": "real.assert_field_number",
        "selector": "#fhId_CPU_Usage",
        "suffix": "%",
        "desc": "CPU 使用率为百分比格式"
      },
      {
        "action": "real.assert_field_number",
        "selector": "#fhId_Memory_Usage",
        "max": 100,
        "suffix": "%",
        "desc": "内存使用率为 0-100% 百分比"
      },
      {
        "action": "real.assert_field_number",
        "selector": "#fhId_Web_port",
        "integer": true,
        "desc": "Web 服务端口为数字"
      },
      {
        "action": "real.assert_field_format",
        "selector": "#fhId_SystemUpTime",
        "format": "duration",
        "desc": "运行时间格式为 Xd Xh Xm Xs"
      },
      {
        "action": "real.assert_field_format",
        "selector": "#fhId_MAC_Address",
        "format": "mac",
        "desc": "MAC 地址格式正确（XX:XX:XX:XX:XX:XX）"
      },
      {
        "action": "real.assert_field_not_equals",
        "selector": "#fhId_ONUState",
        "value": "ERROR",
        "optional": true,
        "desc": "PON 状态非 ERROR（字段缺失视为通过）"
      },
      {
        "action": "real.assert_field_not_equals",
        "selector": "#fhId_ONU_Regist_State",
        "value": "ERROR",
        "optional": true,
        "desc": "PON 注册状态非 ERROR（字段缺失视为通过）"
      }
    ]
  },
  {
    "id": "INTL-STATUS-003",
    "title": "系统运行时间随刷新递增（状态迁移）",
    "priority": "P1",
    "tags": [
      "suite:regression",
      "type:positive",
      "module:status",
      "专项:persist"
    ],
    "precondition": "设备已上电，可正常登录",
    "steps": [
      {
        "action": "real.ensure_login",
        "desc": "确保已登录（会话复用：整个 run 只登录一次；会话失效自动重登）"
      },
      {
        "action": "real.click_menu",
        "l1": "fhId_status_L1",
        "l2": "fhId_deviceInfo_L2",
        "desc": "导航到设备信息"
      },
      {
        "action": "real.assert_visible",
        "selector": "#fhId_SystemUpTime",
        "desc": "运行时间字段可见"
      },
      {
        "action": "real.wait",
        "ms": "3000",
        "desc": "等待 3 秒"
      },
      {
        "action": "real.assert_visible",
        "selector": "#fhId_SystemUpTime",
        "desc": "运行时间字段仍可见"
      }
    ]
  },
  {
    "id": "INTL-STATUS-004",
    "title": "XSS 注入安全（输入/URL/字段数据注入均不执行脚本）",
    "priority": "P1",
    "tags": [
      "suite:regression",
      "专项:security",
      "module:status",
      "专项:security"
    ],
    "precondition": "设备已上电，可正常登录（仅 1 次错误登录，不触发 3 次锁定）",
    "steps": [
      {
        "action": "real.navigate",
        "path": "/login.html",
        "desc": "访问登录页"
      },
      {
        "action": "real.fill",
        "selector": "#user_name",
        "value": "<img src=x onerror=alert(1)>",
        "desc": "用户名注入 XSS payload"
      },
      {
        "action": "real.fill",
        "selector": "#loginpp",
        "value": "x",
        "desc": "输入任意密码"
      },
      {
        "action": "real.click",
        "selector": "#login_btn",
        "desc": "提交登录（触发输入注入）"
      },
      {
        "action": "real.wait",
        "ms": "2000",
        "desc": "等待登录响应"
      },
      {
        "action": "real.no_dialog",
        "desc": "输入注入未触发脚本弹窗（XSS 被转义）"
      },
      {
        "action": "real.fill",
        "selector": "#user_name",
        "value": "${QCT_INTL_ADMIN_USER}",
        "desc": "恢复正确用户名"
      },
      {
        "action": "real.fill",
        "selector": "#loginpp",
        "value": "${QCT_INTL_ADMIN_PASS}",
        "desc": "输入正确密码"
      },
      {
        "action": "real.click",
        "selector": "#login_btn",
        "desc": "正确登录（重置错误计数）"
      },
      {
        "action": "real.assert_url_contains",
        "substring": "main.html#/",
        "desc": "登录成功进入主页"
      },
      {
        "action": "real.navigate",
        "path": "/main.html#/deviceInfo?x=%3Cimg%20src%3Dx%20onerror%3Dalert(1)%3E",
        "desc": "URL 参数注入 XSS payload 访问设备信息页"
      },
      {
        "action": "real.wait",
        "ms": "2000",
        "desc": "等待页面加载与数据请求"
      },
      {
        "action": "real.no_dialog",
        "desc": "URL 注入未触发脚本弹窗"
      },
      {
        "action": "real.assert_visible",
        "selector": "#fhId_SoftwareVersion",
        "desc": "设备信息页正常渲染"
      },
      {
        "action": "real.assert_html_not_contains",
        "selector": "body",
        "texts": [
          "%3Cimg",
          "onerror=alert(1)"
        ],
        "desc": "注入 payload 未以原始/解码形态反射进 DOM"
      },
      {
        "action": "real.inject_vue_data",
        "key": "SoftwareVersion",
        "value": "<img src=x onerror=alert(1)>",
        "desc": "向软件版本数据字段注入恶意数据（组件树定位数据持有者，模拟设备上报）"
      },
      {
        "action": "real.wait",
        "ms": "500",
        "desc": "等待 Vue 重渲染（5 秒定时刷新前完成）"
      },
      {
        "action": "real.no_dialog",
        "desc": "字段数据注入未执行脚本（Vue 插值转义生效）"
      },
      {
        "action": "real.assert_field_plain_text",
        "selector": "#fhId_SoftwareVersion",
        "contains": "<img",
        "tag": "img",
        "desc": "注入内容以纯文本显示，未被解析为元素"
      },
      {
        "action": "real.screenshot",
        "name": "INTL-STATUS-004_xss",
        "desc": "截图 XSS 防护验证结果"
      }
    ]
  }
]
