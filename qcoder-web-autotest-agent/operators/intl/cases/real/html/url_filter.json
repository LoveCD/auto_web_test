        "action": "real.fill",
        "selector": "#fhId_URL",
        "value": "www.autotest004.com",
        "desc": "创建第二条：输入过滤 URL"
      },
      {
        "action": "real.select_time_range",
        "selector": "#f",
        "start": "00:00",
        "end": "23:59",
        "desc": "创建第二条：时间范围 00:00 - 23:59"
      },
      {
        "action": "real.select_option",
        "selector": "#fhId_Enable",
        "option_text": "Enable",
        "desc": "创建第二条：启用规则"
      },
      {
        "action": "real.click",
        "selector": "#fhId_onApply",
        "desc": "创建第二条：点击 Apply 保存"
      },
      {
        "action": "real.wait",
        "ms": "2500",
        "desc": "等待保存完成"
      },
      {
        "action": "real.assert_text_contains",
        "selector": "body",
        "text": "www.autotest004.com",
        "desc": "第二条创建成功：列表出现"
      },
      {
        "action": "real.click",
        "selector": "#fhId_URLFilterLists tr.el-table__row:has-text(\"www.autotest003.com\") .el-checkbox",
        "desc": "批量删除：勾选第一条"
      },
      {
        "action": "real.click",
        "selector": "#fhId_URLFilterLists tr.el-table__row:has-text(\"www.autotest004.com\") .el-checkbox",
        "desc": "批量删除：勾选第二条"
      },
      {
        "action": "real.click",
        "selector": "#fhId_Delete",
        "desc": "批量删除：点击 Delete"
      },
      {
        "action": "real.assert_confirm_visible",
        "keyword": "Are you sure",
        "desc": "批量删除：确认框出现"
      },
      {
        "action": "real.click_confirm",
        "accept": true,
        "desc": "批量删除：确认删除"
      },
      {
        "action": "real.wait",
        "ms": "2500",
        "desc": "等待删除完成"
      },
      {
        "action": "real.assert_text_not_contains",
        "selector": "body",
        "text": "www.autotest003.com",
        "desc": "批量删除：第一条无残留"
      },
      {
        "action": "real.assert_text_not_contains",
        "selector": "body",
        "text": "www.autotest004.com",
        "desc": "批量删除：第二条无残留"
      },
      {
        "action": "real.screenshot",
        "name": "INTL-FW-022_batch_del",
        "desc": "截图批量删除后页面"
      }
    ]
  }
]
