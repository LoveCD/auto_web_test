[
  {
    "id": "INTL-STATUS-106",
    "title": "VoIP 状态页面可访问，注册状态表格显示（带语音端口设备）",
    "priority": "P1",
    "tags": [
      "suite:regression",
      "type:positive",
      "module:status"
    ],
    "precondition": "设备已上电且带 VoIP 端口（pots_num>0），可正常登录",
    "steps": [
      {
        "action": "real.ensure_login",
        "desc": "确保已登录（会话复用：整个 run 只登录一次；会话失效自动重登）"
      },
      {
        "action": "real.click_menu",
        "l1": "fhId_status_L1",
        "l2": "fhId_voipStatus_L2",
        "l3": "fhId_voipStatus_L3",
        "desc": "导航到 VoIP 状态"
      },
      {
        "action": "real.assert_url_contains",
        "substring": "voipStatus",
        "desc": "URL 含 voipStatus"
      },
      {
        "action": "real.assert_visible",
        "selector": "#fhId_voipInfo",
        "desc": "VoIP 状态表格可见"
      },
      {
        "action": "real.screenshot",
        "name": "INTL-STATUS-106_voip",
        "desc": "截图 VoIP 状态页"
      }
    ]
  }
]
