[
  {
    "id": "INTL-WIFI-009",
    "title": "Wi-Fi 功率设置页面可访问，发射功率选项完整",
    "priority": "P1",
    "tags": [
      "suite:regression",
      "type:positive",
      "module:wifi"
    ],
    "precondition": "设备已上电，可正常登录",
    "steps": [
      {
        "action": "real.ensure_login",
        "desc": "确保已登录（会话复用：整个 run 只登录一次；会话失效自动重登）"
      },
      {
        "action": "real.click_menu",
        "l1": "fhId_network_L1",
        "l2": "fhId_wifiSettings_L2",
        "l3": "fhId_wifiControl_L3",
        "desc": "导航到 Wi-Fi 功率设置"
      },
      {
        "action": "real.assert_url_contains",
        "substring": "wifiControl",
        "desc": "URL 含 wifiControl"
      },
      {
        "action": "real.assert_visible",
        "selector": "#fhId_TransmitPower",
        "desc": "发射功率下拉可见"
      },
      {
        "action": "real.assert_option_present",
        "selector": "#fhId_TransmitPower",
        "option_text": "20%",
        "desc": "功率含 20%"
      },
      {
        "action": "real.assert_option_present",
        "selector": "#fhId_TransmitPower",
        "option_text": "40%",
        "desc": "功率含 40%"
      },
      {
        "action": "real.assert_option_present",
        "selector": "#fhId_TransmitPower",
        "option_text": "60%",
        "desc": "功率含 60%"
      },
      {
        "action": "real.assert_option_present",
        "selector": "#fhId_TransmitPower",
        "option_text": "80%",
        "desc": "功率含 80%"
      },
      {
        "action": "real.assert_option_present",
        "selector": "#fhId_TransmitPower",
        "option_text": "100%",
        "desc": "功率含 100%"
      },
      {
        "action": "real.assert_visible",
        "selector": "#fhId_onApplyEnable",
        "desc": "应用按钮可见"
      },
      {
        "action": "real.screenshot",
        "name": "INTL-WIFI-009_power",
        "desc": "截图功率设置页"
      }
    ]
  }
]
