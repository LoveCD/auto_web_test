[
  {
    "id": "INTL-WIFI-017",
    "title": "5G 功率设置页面可访问，发射功率选项完整",
    "priority": "P1",
    "tags": [
      "suite:regression",
      "type:positive",
      "module:wifi"
    ],
    "precondition": "设备已上电，可正常登录；设备支持 5G 频段",
    "steps": [
      {
        "action": "real.ensure_login",
        "desc": "确保已登录（会话复用：整个 run 只登录一次；会话失效自动重登）"
      },
      {
        "action": "real.click_menu",
        "l1": "fhId_network_L1",
        "l2": "fhId_wifiSettings_L2",
        "l3": "fhId_wifiControl_5g_L3",
        "desc": "导航到 5G 功率设置"
      },
      {
        "action": "real.assert_url_contains",
        "substring": "wifiControl_5g",
        "desc": "URL 含 wifiControl_5g"
      },
      {
        "action": "real.assert_visible",
        "selector": "#fhId_TransmitPower",
        "desc": "发射功率下拉可见"
      },
      {
        "action": "real.assert_option_present",
        "selector": "#fhId_TransmitPower",
        "option_text": "20%",
        "desc": "功率含 20%"
      },
      {
        "action": "real.assert_option_present",
        "selector": "#fhId_TransmitPower",
        "option_text": "100%",
        "desc": "功率含 100%"
      },
      {
        "action": "real.screenshot",
        "name": "INTL-WIFI-017_power5g",
        "desc": "截图 5G 功率设置页"
      }
    ]
  }
]
