[
  {
    "id": "INTL-LOGIN-001",
    "title": "正确账号密码登录成功，跳转首页",
    "priority": "P0",
    "tags": ["suite:smoke", "type:positive", "module:login"],
    "precondition": "设备已上电，浏览器可访问 192.168.1.1",
    "steps": [
      {"action": "real.navigate", "path": "/login.html", "desc": "访问登录页"},
      {"action": "real.assert_visible", "selector": "#user_name", "desc": "用户名输入框可见"},
      {"action": "real.assert_visible", "selector": "#loginpp", "desc": "密码输入框可见"},
      {"action": "real.fill", "selector": "#user_name", "value": "admin", "desc": "输入正确用户名"},
      {"action": "real.fill", "selector": "#loginpp", "value": "${QCT_INTL_ADMIN_PASS}", "desc": "输入正确密码"},
      {"action": "real.click", "selector": "#login_btn", "desc": "点击登录"},
      {"action": "real.assert_url_contains", "substring": "main.html#/home", "desc": "跳转到首页"},
      {"action": "real.assert_visible", "selector": "#app", "desc": "主应用容器可见"},
      {"action": "real.screenshot", "name": "INTL-LOGIN-001_home", "desc": "截图首页"}
    ]
  },
  {
    "id": "INTL-LOGIN-002",
    "title": "错误密码登录失败，提示错误信息",
    "priority": "P0",
    "tags": ["suite:smoke", "type:negative", "module:login"],
    "precondition": "设备已上电，浏览器可访问 192.168.1.1",
    "steps": [
      {"action": "real.navigate", "path": "/login.html", "desc": "访问登录页"},
      {"action": "real.fill", "selector": "#user_name", "value": "admin", "desc": "输入正确用户名"},
      {"action": "real.fill", "selector": "#loginpp", "value": "WrongPass123", "desc": "输入错误密码"},
      {"action": "real.click", "selector": "#login_btn", "desc": "点击登录"},
      {"action": "real.assert_login_error", "desc": "断言错误提示显示"},
      {"action": "real.assert_url_contains", "substring": "login.html", "desc": "仍停留在登录页"},
      {"action": "real.screenshot", "name": "INTL-LOGIN-002_error", "desc": "截图错误提示"}
    ]
  },
  {
    "id": "INTL-LOGIN-003",
    "title": "空用户名登录被前端校验拦截",
    "priority": "P1",
    "tags": ["suite:regression", "type:negative", "module:login"],
    "precondition": "设备已上电，浏览器可访问 192.168.1.1",
    "steps": [
      {"action": "real.navigate", "path": "/login.html", "desc": "访问登录页"},
      {"action": "real.fill", "selector": "#user_name", "value": "", "desc": "清空用户名"},
      {"action": "real.fill", "selector": "#loginpp", "value": "${QCT_INTL_ADMIN_PASS}", "desc": "输入正确密码"},
      {"action": "real.click", "selector": "#login_btn", "desc": "点击登录"},
      {"action": "real.assert_login_stays", "desc": "前端校验拦截，停留登录页且无错误提示"}
    ]
  },
  {
    "id": "INTL-LOGIN-004",
    "title": "空密码登录被前端校验拦截",
    "priority": "P1",
    "tags": ["suite:regression", "type:negative", "module:login"],
    "precondition": "设备已上电，浏览器可访问 192.168.1.1",
    "steps": [
      {"action": "real.navigate", "path": "/login.html", "desc": "访问登录页"},
      {"action": "real.fill", "selector": "#user_name", "value": "admin", "desc": "输入正确用户名"},
      {"action": "real.fill", "selector": "#loginpp", "value": "", "desc": "清空密码"},
      {"action": "real.click", "selector": "#login_btn", "desc": "点击登录"},
      {"action": "real.assert_login_stays", "desc": "前端校验拦截，停留登录页且无错误提示"}
    ]
  },
  {
    "id": "INTL-LOGIN-005",
    "title": "用户名前后空格登录失败（BVA）",
    "priority": "P1",
    "tags": ["suite:regression", "type:boundary", "module:login"],
    "precondition": "设备已上电，浏览器可访问 192.168.1.1",
    "steps": [
      {"action": "real.navigate", "path": "/login.html", "desc": "访问登录页"},
      {"action": "real.fill", "selector": "#user_name", "value": " admin ", "desc": "输入带前后空格的用户名"},
      {"action": "real.fill", "selector": "#loginpp", "value": "${QCT_INTL_ADMIN_PASS}", "desc": "输入正确密码"},
      {"action": "real.click", "selector": "#login_btn", "desc": "点击登录"},
      {"action": "real.assert_login_error", "desc": "断言错误提示显示（空格不自动去除）"},
      {"action": "real.assert_url_contains", "substring": "login.html", "desc": "仍停留在登录页"}
    ]
  },
  {
    "id": "INTL-LOGIN-006",
    "title": "登出后返回登录页",
    "priority": "P0",
    "tags": ["suite:smoke", "type:positive", "module:login"],
    "precondition": "设备已上电，可正常登录",
    "steps": [
      {"action": "real.navigate", "path": "/login.html", "desc": "访问登录页"},
      {"action": "real.fill", "selector": "#user_name", "value": "admin", "desc": "输入正确用户名"},
      {"action": "real.fill", "selector": "#loginpp", "value": "${QCT_INTL_ADMIN_PASS}", "desc": "输入正确密码"},
      {"action": "real.click", "selector": "#login_btn", "desc": "点击登录"},
      {"action": "real.assert_url_contains", "substring": "main.html#/home", "desc": "登录成功"},
      {"action": "real.logout", "desc": "点击登出并确认"},
      {"action": "real.assert_url_contains", "substring": "login.html", "desc": "登出后回到登录页"},
      {"action": "real.screenshot", "name": "INTL-LOGIN-006_logout", "desc": "截图登出后页面"}
    ]
  },
  {
    "id": "INTL-LOGIN-007",
    "title": "未登录直接访问受保护页面，跳转登录页",
    "priority": "P1",
    "tags": ["suite:regression", "type:negative", "module:login", "专项:auth"],
    "precondition": "设备已上电，浏览器无登录会话",
    "steps": [
      {"action": "real.navigate", "path": "/main.html#/home", "desc": "未登录直接访问首页"},
      {"action": "real.assert_unauth_redirect", "desc": "未登录访问应跳转登录页或登录表单可见"}
    ]
  },
  {
    "id": "INTL-LOGIN-008",
    "title": "密码连续错误3次触发账号锁定",
    "priority": "P1",
    "tags": ["suite:regression", "type:negative", "module:login", "专项:security"],
    "precondition": "设备已上电，浏览器可访问 192.168.1.1，无未过期的登录锁定状态",
    "steps": [
      {"action": "real.navigate", "path": "/login.html", "desc": "访问登录页"},
      {"action": "real.fill", "selector": "#user_name", "value": "admin", "desc": "输入用户名"},
      {"action": "real.fill", "selector": "#loginpp", "value": "WrongPass1", "desc": "第1次输入错误密码"},
      {"action": "real.click", "selector": "#login_btn", "desc": "点击登录"},
      {"action": "real.assert_login_error", "desc": "第1次登录失败提示"},
      {"action": "real.wait", "ms": "3000", "desc": "等待设备处理第1次错误请求"},
      {"action": "real.fill", "selector": "#user_name", "value": "admin", "desc": "输入用户名"},
      {"action": "real.fill", "selector": "#loginpp", "value": "WrongPass2", "desc": "第2次输入错误密码"},
      {"action": "real.click", "selector": "#login_btn", "desc": "点击登录"},
      {"action": "real.assert_login_error", "desc": "第2次登录失败提示"},
      {"action": "real.wait", "ms": "3000", "desc": "等待设备处理第2次错误请求"},
      {"action": "real.fill", "selector": "#user_name", "value": "admin", "desc": "输入用户名"},
      {"action": "real.fill", "selector": "#loginpp", "value": "WrongPass3", "desc": "第3次输入错误密码"},
      {"action": "real.click", "selector": "#login_btn", "desc": "点击登录"},
      {"action": "real.wait", "ms": "5000", "desc": "等待锁定提示更新（设备返回锁定提示有延迟）"},
      {"action": "real.assert_text_contains", "selector": "#login_error_hint", "text": "wrong 3 times", "desc": "连续3次错误后账号被锁定，提示锁定信息"},
      {"action": "real.assert_url_contains", "substring": "login.html", "desc": "账号锁定，仍停留在登录页"},
      {"action": "real.screenshot", "name": "INTL-LOGIN-008_locked", "desc": "截图账号锁定提示"}
    ]
  }
]
