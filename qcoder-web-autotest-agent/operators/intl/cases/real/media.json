      {"action": "real.click_menu", "l1": "fhId_application_L1", "l2": "fhId_mediaShare_L2", "desc": "进入媒体共享页"},
      {"action": "real.assert_url_contains", "substring": "mediaShare", "desc": "URL 应包含 mediaShare 路由"},
      {"action": "real.assert_visible", "selector": "media.ftp_enable", "desc": "FTP 启用选项可见"},
      {"action": "real.screenshot", "name": "INTL-MEDIA-001_query", "desc": "截图媒体共享配置查询结果"}
