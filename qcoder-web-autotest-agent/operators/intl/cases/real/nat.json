[
  {
    "id": "INTL-NAT-001",
    "title": "NAT 端口映射列表查询展示",
    "priority": "P0",
    "tags": ["suite:regression", "type:positive", "module:nat", "专项:query"],
    "precondition": "设备已上电，已登录，浏览器可访问 192.168.1.1",
    "steps": [
      {"action": "real.navigate", "path": "/login.html", "desc": "访问登录页"},
      {"action": "real.login", "desc": "管理员登录"},
      {"action": "real.click_menu", "l1": "fhId_application_L1", "l2": "fhId_nat_L2", "desc": "进入 NAT 端口映射页"},
      {"action": "real.assert_url_contains", "substring": "nat", "desc": "URL 应包含 nat 路由"},
      {"action": "real.assert_visible", "selector": "nat.add_btn", "desc": "添加按钮可见"},
      {"action": "real.assert_visible", "selector": "nat.delete_btn", "desc": "删除按钮可见"},
      {"action": "real.screenshot", "name": "INTL-NAT-001_query", "desc": "截图 NAT 列表查询结果"}
    ]
  },
  {
    "id": "INTL-NAT-002",
    "title": "NAT 端口映射创建/查询/修改/删除（CRUD）",
    "priority": "P1",
    "tags": ["suite:regression", "type:positive", "module:nat", "专项:crud"],
    "precondition": "设备已上电，已登录，可创建 WAN 连接（NAT 依赖 WAN）",
    "steps": [
      {"action": "real.navigate", "path": "/login.html", "desc": "访问登录页"},
      {"action": "real.login", "desc": "管理员登录"},
      {"action": "real.click_menu", "l1": "fhId_network_L1", "l2": "fhId_broadBandSettings_L2", "desc": "进入宽带设置"},
      {"action": "real.cleanup_wan", "desc": "清理残留 WAN，保证起始干净"},
      {"action": "real.click", "selector": "#fhId_Add", "desc": "创建前置 WAN：点击 Add"},
      {"action": "real.select_option", "selector": "#fhId_ServiceList", "option_text": "INTERNET", "desc": "选择 INTERNET"},
      {"action": "real.select_option", "selector": "#fhId_connectMode", "option_text": "Route", "desc": "选择 Route"},
      {"action": "real.select_option", "selector": "#fhId_iporppp", "option_text": "IPoE", "desc": "选择 IPoE"},
      {"action": "real.select_option", "selector": "#fhId_AddressingType", "option_text": "DHCP", "desc": "选择 DHCP"},
      {"action": "real.fill", "selector": "#fhId_VLANID", "value": "201", "desc": "输入 VLAN 201"},
      {"action": "real.click", "selector": "#fhId_onApply", "desc": "保存前置 WAN"},
      {"action": "real.wait", "ms": "2500", "desc": "等待 WAN 创建"},
      {"action": "real.assert_text_contains", "selector": "body", "text": "INTERNET_R_VID_201", "desc": "前置 WAN 创建成功"},
      {"action": "real.click_menu", "l1": "fhId_application_L1", "l2": "fhId_nat_L2", "desc": "进入 NAT 页"},
      {"action": "real.click", "selector": "nat.add_btn", "desc": "创建 NAT：点击 Add"},
      {"action": "real.wait", "ms": "1200", "desc": "等待添加抽屉打开"},
      {"action": "real.select_option", "selector": "nat.wan_select", "option_text": "INTERNET_R_VID_201", "desc": "选择前置 WAN 连接"},
      {"action": "real.fill", "selector": "nat.description", "value": "test_nat_001", "desc": "输入描述 test_nat_001"},
      {"action": "real.fill", "selector": "nat.ext_port", "value": "8080", "desc": "输入外部端口 8080"},
      {"action": "real.fill", "selector": "nat.ext_port_end", "value": "8080", "desc": "输入外部端口结束 8080"},
      {"action": "real.fill", "selector": "nat.internal_client", "value": "192.168.1.100", "desc": "输入内网客户端"},
      {"action": "real.fill", "selector": "nat.internal_port", "value": "80", "desc": "输入内部端口 80"},
      {"action": "real.fill", "selector": "nat.internal_port_end", "value": "80", "desc": "输入内部端口结束 80"},
      {"action": "real.click", "selector": "nat.apply", "desc": "保存 NAT 记录"},
      {"action": "real.wait", "ms": "2500", "desc": "等待 NAT 保存"},
      {"action": "real.assert_text_contains", "selector": "body", "text": "test_nat_001", "desc": "查询：列表出现 NAT 记录"},
      {"action": "real.click", "selector": "tr:has-text(\"test_nat_001\") .edit_icon", "desc": "查询：点击编辑图标打开详情"},
      {"action": "real.wait", "ms": "1500", "desc": "等待详情加载"},
      {"action": "real.assert_input_value", "selector": "nat.ext_port", "value": "8080", "desc": "查询：外部端口回读为 8080"},
      {"action": "real.fill", "selector": "nat.ext_port", "value": "9090", "desc": "修改：外部端口改为 9090"},
      {"action": "real.click", "selector": "nat.apply", "desc": "修改：保存"},
      {"action": "real.wait", "ms": "2500", "desc": "等待修改保存"},
      {"action": "real.assert_input_value", "selector": "nat.ext_port", "value": "9090", "desc": "修改：外部端口回读为 9090"},
      {"action": "real.click", "selector": ".el-drawer__close-btn", "desc": "删除：关闭编辑抽屉"},
      {"action": "real.wait", "ms": "800", "desc": "等待抽屉关闭"},
      {"action": "real.click", "selector": "tr:has-text(\"test_nat_001\") .el-checkbox", "desc": "删除：勾选目标行复选框"},
      {"action": "real.click", "selector": "nat.delete_btn", "desc": "删除：点击工具栏 Delete"},
      {"action": "real.assert_confirm_visible", "keyword": "delete", "desc": "删除：确认框出现"},
      {"action": "real.click_confirm", "accept": true, "desc": "删除：确认"},
      {"action": "real.wait", "ms": "2500", "desc": "等待删除完成"},
      {"action": "real.assert_text_not_contains", "selector": "body", "text": "test_nat_001", "desc": "删除：NAT 记录已消失"},
      {"action": "real.click_menu", "l1": "fhId_network_L1", "l2": "fhId_broadBandSettings_L2", "desc": "返回宽带设置清理 WAN"},
      {"action": "real.cleanup_wan", "desc": "清理前置 WAN，恢复设备状态"},
      {"action": "real.screenshot", "name": "INTL-NAT-002_done", "desc": "截图 CRUD 完成状态"}
    ]
  },
  {
    "id": "INTL-NAT-003",
    "title": "NAT 端口范围异常值校验（越界/非法端口）",
    "priority": "P1",
    "tags": ["suite:regression", "type:negative", "module:nat", "专项:invalid"],
    "precondition": "设备已上电，已登录，可创建 WAN 连接",
    "steps": [
      {"action": "real.navigate", "path": "/login.html", "desc": "访问登录页"},
      {"action": "real.login", "desc": "管理员登录"},
      {"action": "real.click_menu", "l1": "fhId_network_L1", "l2": "fhId_broadBandSettings_L2", "desc": "进入宽带设置"},
      {"action": "real.cleanup_wan", "desc": "清理残留 WAN"},
      {"action": "real.click", "selector": "#fhId_Add", "desc": "创建前置 WAN：点击 Add"},
      {"action": "real.select_option", "selector": "#fhId_ServiceList", "option_text": "INTERNET", "desc": "选择 INTERNET"},
      {"action": "real.select_option", "selector": "#fhId_connectMode", "option_text": "Route", "desc": "选择 Route"},
      {"action": "real.select_option", "selector": "#fhId_iporppp", "option_text": "IPoE", "desc": "选择 IPoE"},
      {"action": "real.select_option", "selector": "#fhId_AddressingType", "option_text": "DHCP", "desc": "选择 DHCP"},
      {"action": "real.fill", "selector": "#fhId_VLANID", "value": "202", "desc": "输入 VLAN 202"},
      {"action": "real.click", "selector": "#fhId_onApply", "desc": "保存前置 WAN"},
      {"action": "real.wait", "ms": "2500", "desc": "等待 WAN 创建"},
      {"action": "real.click_menu", "l1": "fhId_application_L1", "l2": "fhId_nat_L2", "desc": "进入 NAT 页"},
      {"action": "real.click", "selector": "nat.add_btn", "desc": "创建 NAT：点击 Add"},
      {"action": "real.wait", "ms": "1200", "desc": "等待添加抽屉打开"},
      {"action": "real.select_option", "selector": "nat.wan_select", "option_text": "INTERNET_R_VID_202", "desc": "选择前置 WAN 连接"},
      {"action": "real.fill", "selector": "nat.ext_port", "value": "70000", "desc": "输入越界外部端口 70000（>65535）"},
      {"action": "real.fill", "selector": "nat.ext_port_end", "value": "70000", "desc": "输入外部端口结束 70000"},
      {"action": "real.fill", "selector": "nat.internal_client", "value": "192.168.1.100", "desc": "输入内网客户端"},
      {"action": "real.fill", "selector": "nat.internal_port", "value": "80", "desc": "输入内部端口 80"},
      {"action": "real.fill", "selector": "nat.internal_port_end", "value": "80", "desc": "输入内部端口结束 80"},
      {"action": "real.click", "selector": "nat.apply", "desc": "保存"},
      {"action": "real.wait", "ms": "1500", "desc": "等待校验"},
      {"action": "real.assert_text_not_contains", "selector": "body", "text": "70000", "desc": "越界端口不应创建 NAT 记录"},
      {"action": "real.fill", "selector": "nat.ext_port", "value": "abc", "desc": "输入非数字外部端口 abc"},
      {"action": "real.click", "selector": "nat.apply", "desc": "保存"},
      {"action": "real.wait", "ms": "1500", "desc": "等待校验"},
      {"action": "real.assert_text_not_contains", "selector": "body", "text": "abc", "desc": "非数字端口不应创建 NAT 记录"},
      {"action": "real.screenshot", "name": "INTL-NAT-003_invalid", "desc": "截图端口异常校验结果"},
      {"action": "real.click", "selector": ".el-drawer__close-btn", "desc": "关闭添加抽屉（校验失败后抽屉仍打开）"},
      {"action": "real.wait", "ms": "800", "desc": "等待抽屉关闭"},
      {"action": "real.click_menu", "l1": "fhId_network_L1", "l2": "fhId_broadBandSettings_L2", "desc": "返回宽带设置清理 WAN"},
      {"action": "real.cleanup_wan", "desc": "清理前置 WAN"}
    ]
  }
]
