[
  {
    "id": "INTL-DDNS-001",
    "title": "DDNS 配置列表查询展示",
    "priority": "P2",
    "tags": ["suite:regression", "type:positive", "module:application", "专项:query"],
    "precondition": "设备已上电，已登录，浏览器可访问 192.168.1.1",
    "steps": [
      {"action": "real.navigate", "path": "/login.html", "desc": "访问登录页"},
      {"action": "real.login", "desc": "管理员登录"},
      {"action": "real.click_menu", "l1": "fhId_application_L1", "l2": "fhId_ddns_L2", "desc": "进入 DDNS 设置页"},
      {"action": "real.assert_url_contains", "substring": "ddns", "desc": "URL 应包含 ddns 路由"},
      {"action": "real.assert_visible", "selector": "ddns.add_btn", "desc": "添加按钮可见"},
      {"action": "real.assert_visible", "selector": "ddns.delete_btn", "desc": "删除按钮可见"},
      {"action": "real.screenshot", "name": "INTL-DDNS-001_query", "desc": "截图 DDNS 列表查询结果"}
    ]
  },
  {
    "id": "INTL-DDNS-002",
    "title": "DDNS 记录创建/查询/修改/删除（CRUD）",
    "priority": "P2",
    "tags": ["suite:regression", "type:positive", "module:application", "专项:crud"],
    "precondition": "设备已上电，已登录，可创建 WAN 连接（DDNS 依赖 WAN）",
    "steps": [
      {"action": "real.navigate", "path": "/login.html", "desc": "访问登录页"},
      {"action": "real.login", "desc": "管理员登录"},
      {"action": "real.click_menu", "l1": "fhId_network_L1", "l2": "fhId_broadBandSettings_L2", "desc": "进入宽带设置"},
      {"action": "real.cleanup_wan", "desc": "清理残留 WAN"},
      {"action": "real.click", "selector": "#fhId_Add", "desc": "创建前置 WAN：点击 Add"},
      {"action": "real.select_option", "selector": "#fhId_ServiceList", "option_text": "INTERNET", "desc": "选择 INTERNET"},
      {"action": "real.select_option", "selector": "#fhId_connectMode", "option_text": "Route", "desc": "选择 Route"},
      {"action": "real.select_option", "selector": "#fhId_iporppp", "option_text": "IPoE", "desc": "选择 IPoE"},
      {"action": "real.select_option", "selector": "#fhId_AddressingType", "option_text": "DHCP", "desc": "选择 DHCP"},
      {"action": "real.fill", "selector": "#fhId_VLANID", "value": "203", "desc": "输入 VLAN 203"},
      {"action": "real.click", "selector": "#fhId_onApply", "desc": "保存前置 WAN"},
      {"action": "real.wait", "ms": "2500", "desc": "等待 WAN 创建"},
      {"action": "real.click_menu", "l1": "fhId_application_L1", "l2": "fhId_ddns_L2", "desc": "进入 DDNS 页"},
      {"action": "real.click", "selector": "ddns.add_btn", "desc": "创建 DDNS：点击 Add"},
      {"action": "real.wait", "ms": "1200", "desc": "等待添加抽屉打开"},
      {"action": "real.select_option", "selector": "ddns.enabled", "option_text": "Enable", "desc": "启用 DDNS"},
      {"action": "real.select_option", "selector": "ddns.wan_select", "option_text": "1_INTERNET_R_VID_203", "desc": "选择前置 WAN 接口"},
      {"action": "real.select_option", "selector": "ddns.provider", "option_text": "www.3322.org", "desc": "选择 DDNS 服务商"},
      {"action": "real.fill", "selector": "ddns.username", "value": "test_ddns", "desc": "输入 DDNS 用户名"},
      {"action": "real.fill", "selector": "ddns.password", "value": "test123", "desc": "输入 DDNS 密码"},
      {"action": "real.fill", "selector": "ddns.hostname", "value": "test.ddns.net", "desc": "输入主机名"},
      {"action": "real.click", "selector": "ddns.apply", "desc": "保存 DDNS 记录"},
      {"action": "real.wait", "ms": "2500", "desc": "等待 DDNS 保存"},
      {"action": "real.assert_text_contains", "selector": "body", "text": "test.ddns.net", "desc": "查询：列表出现 DDNS 记录"},
      {"action": "real.click", "selector": "tr:has-text(\"test.ddns.net\") .edit_icon", "desc": "查询：点击编辑图标打开详情"},
      {"action": "real.wait", "ms": "1500", "desc": "等待详情加载"},
      {"action": "real.assert_input_value", "selector": "ddns.hostname", "value": "test.ddns.net", "desc": "查询：主机名回读正确"},
      {"action": "real.assert_input_value_not", "selector": "ddns.password", "value": "test123", "desc": "安全：密码字段回填为假密码（防泄露）"},
      {"action": "real.fill", "selector": "ddns.hostname", "value": "test2.ddns.net", "desc": "修改：主机名改为 test2.ddns.net"},
      {"action": "real.click", "selector": "ddns.apply", "desc": "修改：保存"},
      {"action": "real.wait", "ms": "2500", "desc": "等待修改保存"},
      {"action": "real.assert_text_contains", "selector": "body", "text": "test2.ddns.net", "desc": "修改：列表出现修改后的主机名"},
      {"action": "real.click", "selector": "tr:has-text(\"test2.ddns.net\") .el-checkbox", "desc": "删除：勾选目标行复选框"},
      {"action": "real.click", "selector": "ddns.delete_btn", "desc": "删除：点击工具栏 Delete"},
      {"action": "real.assert_confirm_visible", "keyword": "delete", "desc": "删除：确认框出现"},
      {"action": "real.click_confirm", "accept": true, "desc": "删除：确认"},
      {"action": "real.wait", "ms": "2500", "desc": "等待删除完成"},
      {"action": "real.assert_text_not_contains", "selector": "body", "text": "test2.ddns.net", "desc": "删除：DDNS 记录已消失"},
      {"action": "real.click_menu", "l1": "fhId_network_L1", "l2": "fhId_broadBandSettings_L2", "desc": "返回宽带设置清理 WAN"},
      {"action": "real.cleanup_wan", "desc": "清理前置 WAN，恢复设备状态"},
      {"action": "real.screenshot", "name": "INTL-DDNS-002_done", "desc": "截图 CRUD 完成状态"}
    ]
  }
]
