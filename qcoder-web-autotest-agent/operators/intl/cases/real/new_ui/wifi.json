[
  {
    "id": "INTL-WIFI-001",
    "title": "WLAN 基本信息查询展示",
    "priority": "P0",
    "tags": ["suite:regression", "type:positive", "module:wifi", "专项:query"],
    "precondition": "设备已上电，已登录，浏览器可访问 192.168.1.1",
    "steps": [
      {"action": "real.navigate", "path": "/login.html", "desc": "访问登录页"},
      {"action": "real.login", "desc": "管理员登录"},
      {"action": "real.click_menu", "l1": "fhId_network_L1", "l2": "fhId_wifiSettings_L2", "desc": "进入 WLAN 设置页"},
      {"action": "real.assert_url_contains", "substring": "wifiSettings", "desc": "URL 应包含 wifiSettings 路由"},
      {"action": "real.assert_visible", "selector": "wifi.ssid", "desc": "SSID 名称输入框可见"},
      {"action": "real.assert_visible", "selector": "wifi.security_mode", "desc": "安全模式下拉可见"},
      {"action": "real.assert_visible", "selector": "wifi.max_clients", "desc": "最大客户端数输入框可见"},
      {"action": "real.assert_input_value_not", "selector": "wifi.ssid", "value": "", "desc": "SSID 名称非空"},
      {"action": "real.screenshot", "name": "INTL-WIFI-001_query", "desc": "截图 WLAN 查询结果"}
    ]
  },
  {
    "id": "INTL-WIFI-002",
    "title": "SSID 名称合法修改并回读验证",
    "priority": "P0",
    "tags": ["suite:regression", "type:positive", "module:wifi", "专项:crud"],
    "precondition": "设备已上电，已登录，WLAN 页可访问",
    "steps": [
      {"action": "real.navigate", "path": "/login.html", "desc": "访问登录页"},
      {"action": "real.login", "desc": "管理员登录"},
      {"action": "real.click_menu", "l1": "fhId_network_L1", "l2": "fhId_wifiSettings_L2", "desc": "进入 WLAN 设置页"},
      {"action": "real.fill", "selector": "wifi.ssid", "value": "TestSSID", "desc": "修改 SSID 为合法值 TestSSID"},
      {"action": "real.click", "selector": "wifi.apply", "desc": "点击应用"},
      {"action": "real.wait", "ms": "2000", "desc": "等待应用生效"},
      {"action": "real.assert_input_value", "selector": "wifi.ssid", "value": "TestSSID", "desc": "回读验证 SSID 已更新为 TestSSID"},
      {"action": "real.screenshot", "name": "INTL-WIFI-002_applied", "desc": "截图修改结果"}
    ]
  },
