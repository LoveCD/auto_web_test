      {"action": "real.click_menu", "l1": "fhId_application_L1", "l2": "fhId_networkTiming_L2", "desc": "进入网络时间设置页"},
      {"action": "real.fill", "selector": "ntp.interval", "value": "86400", "desc": "恢复同步间隔为默认值 86400"},
      {"action": "real.click", "selector": "ntp.check_now", "desc": "点击 Check Time 生效"},
      {"action": "real.wait", "ms": "2000", "desc": "等待生效"},
      {"action": "real.assert_input_value", "selector": "ntp.interval", "value": "86400", "desc": "回读验证同步间隔已恢复为 86400"},
      {"action": "real.screenshot", "name": "INTL-NTP-003_restored", "desc": "截图恢复结果"}
    ]
  },
