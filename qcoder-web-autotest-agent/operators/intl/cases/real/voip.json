      {"action": "real.fill", "selector": "voip.registrar_port", "value": "5060", "desc": "恢复注册端口为默认值 5060"},
      {"action": "real.click", "selector": "voip.apply", "desc": "点击应用"},
      {"action": "real.wait", "ms": "2000", "desc": "等待应用生效"},
