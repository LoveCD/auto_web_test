  {
    "id": "INTL-WAN-CRUD-001",
    "title": "INTERNET 路由 PPP WAN 创建/查询/修改/删除（CRUD）",
    "priority": "P1",
    "tags": ["suite:regression", "type:positive", "module:wan", "专项:crud"],
    "precondition": "设备已上电，可正常登录",
    "steps": [
      {"action": "real.navigate", "path": "/login.html", "desc": "访问登录页"},
      {"action": "real.fill", "selector": "#user_name", "value": "admin", "desc": "输入用户名"},
      {"action": "real.fill", "selector": "#loginpp", "value": "${QCT_INTL_ADMIN_PASS}", "desc": "输入密码"},
      {"action": "real.click", "selector": "#login_btn", "desc": "登录"},
      {"action": "real.click_menu", "l1": "fhId_network_L1", "l2": "fhId_broadBandSettings_L2", "desc": "导航到宽带设置"},
      {"action": "real.click", "selector": "#fhId_Add", "desc": "创建：点击 Add New WAN"},
      {"action": "real.select_option", "selector": "#fhId_ServiceList", "option_text": "INTERNET", "desc": "选择服务类型 INTERNET"},
      {"action": "real.select_option", "selector": "#fhId_connectMode", "option_text": "Route", "desc": "选择连接模式 Route"},
      {"action": "real.select_option", "selector": "#fhId_iporppp", "option_text": "PPPoE", "desc": "选择 IP 封装 PPPoE"},
      {"action": "real.fill", "selector": "#fhId_VLANID", "value": "100", "desc": "输入 VLAN ID 100"},
      {"action": "real.fill", "selector": "#fhId_MTU", "value": "1492", "desc": "输入 MTU 1492"},
      {"action": "real.fill", "selector": "#fhId_Username", "value": "test_pppoe", "desc": "输入 PPPoE 用户名"},
      {"action": "real.fill", "selector": "#fhId_Password", "value": "test123", "desc": "输入 PPPoE 密码"},
      {"action": "real.click", "selector": "#fhId_onApply", "desc": "点击 Apply 保存"},
      {"action": "real.wait", "ms": "2500", "desc": "等待保存完成"},
      {"action": "real.assert_text_contains", "selector": "body", "text": "1_INTERNET_R_VID_100", "desc": "查询：列表出现 INTERNET 路由 PPP WAN"},
      {"action": "real.click", "selector": "text=1_INTERNET_R_VID_100", "desc": "查询：点击列表项查看详情"},
      {"action": "real.wait", "ms": "1500", "desc": "等待详情加载"},
      {"action": "real.assert_input_value", "selector": "#fhId_VLANID", "value": "100", "desc": "查询：VLAN ID 回读为 100"},
      {"action": "real.fill", "selector": "#fhId_MTU", "value": "1400", "desc": "修改：修改 MTU 为 1400"},
      {"action": "real.click", "selector": "#fhId_onApply", "desc": "修改：点击 Apply 保存"},
      {"action": "real.wait", "ms": "2500", "desc": "等待修改保存"},
      {"action": "real.assert_input_value", "selector": "#fhId_MTU", "value": "1400", "desc": "修改：MTU 回读为 1400"},
      {"action": "real.click", "selector": "#fhId_Wan1 .del_wan_icon", "desc": "删除：点击列表项删除图标"},
      {"action": "real.assert_confirm_visible", "keyword": "delete", "desc": "删除：确认框出现"},
      {"action": "real.click_confirm", "accept": true, "desc": "删除：点击 Confirm 确认"},
      {"action": "real.wait", "ms": "2500", "desc": "等待删除完成"},
      {"action": "real.assert_text_not_contains", "selector": "body", "text": "1_INTERNET_R_VID_100", "desc": "删除：列表项已消失"},
      {"action": "real.screenshot", "name": "INTL-WAN-CRUD-001_done", "desc": "截图删除后页面"}
    ]
  },
